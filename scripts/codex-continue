#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "fileutils"
require "open3"

ACTIONS = [
  "merge_reviewed_pr",
  "pick_next_ticket",
  "continue_implementation",
  "run_ci",
  "create_draft_pr",
  "show_pr_link",
  "stop"
].freeze

def require_tool!(name)
  system("command -v #{name} >/dev/null 2>&1") || abort("Missing required tool: #{name}")
end

%w[git gh ruby].each { |tool| require_tool!(tool) }

def write(path, content)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, content)
end

def read(path)
  File.exist?(path) ? File.read(path) : ""
end

def sh(*args)
  stdout, stderr, status = Open3.capture3(*args)

  {
    stdout: stdout,
    stderr: stderr,
    success: status.success?,
    exit_code: status.exitstatus
  }
end

def sh!(*args)
  result = sh(*args)

  unless result[:success]
    abort <<~MSG
      Command failed:
      #{args.join(" ")}

      STDERR:
      #{result[:stderr]}
    MSG
  end

  result[:stdout]
end

def file_exists(path)
  File.exist?(path)
end

def json_read(path)
  return nil unless File.exist?(path)

  JSON.parse(File.read(path))
rescue JSON::ParserError
  nil
end

def current_pr_info
  result = sh(
    "gh",
    "pr",
    "view",
    "--json",
    "number,state,isDraft,mergeStateStatus,statusCheckRollup,url"
  )

  return nil unless result[:success]
  return nil if result[:stdout].strip.empty?

  JSON.parse(result[:stdout])
rescue JSON::ParserError
  nil
end

def open_pr?(pr_info)
  pr_info && pr_info["state"] == "OPEN"
end

def merged_pr?(pr_info)
  pr_info && pr_info["state"] == "MERGED"
end

def task_matches_current_branch?(selected_issue, current_branch)
  selected_issue && selected_issue["branch"] == current_branch
end

def ci_green?(ci_status)
  ci_status&.dig("overall", "passed") == true
end

def determine_action(pr_info:, selected_issue:, ci_status:, current_branch:, has_task:, has_report:, has_pr_url:)
  if open_pr?(pr_info)
    return [
      "merge_reviewed_pr",
      "Open PR exists for the current branch, so continue should run the merge/finalization script."
    ]
  end

  if merged_pr?(pr_info)
    return [
      "pick_next_ticket",
      "The current PR is already merged, so continue should move to the next ticket."
    ]
  end

  unless has_task
    return [
      "pick_next_ticket",
      "There is no active task file, so continue should select the next issue."
    ]
  end

  unless task_matches_current_branch?(selected_issue, current_branch)
    return [
      "pick_next_ticket",
      "Selected issue metadata does not match the current branch, so continue should select a fresh ticket."
    ]
  end

  unless has_report
    return [
      "continue_implementation",
      "The active task has no Codex report yet, so implementation should continue."
    ]
  end

  unless ci_green?(ci_status)
    return [
      "run_ci",
      "Implementation report exists but CI is not green yet, so continue should run local CI."
    ]
  end

  if has_pr_url
    return [
      "show_pr_link",
      "CI is green and a PR URL has already been recorded, so continue should show the link."
    ]
  end

  [
    "create_draft_pr",
    "CI is green for the active branch and no PR URL is recorded, so continue should create the draft PR."
  ]
end

FileUtils.mkdir_p(".ai/continue")

git_status = sh!("git", "status", "--short", "--branch")
current_branch = sh!("git", "branch", "--show-current").strip
pr_info = current_pr_info
selected_issue = json_read(".ai/selected-issue.json")
ci_status = json_read(".ai/ci-status.json")

state = {
  "current_branch" => current_branch,
  "git_status" => git_status,
  "has_current_pr" => open_pr?(pr_info),
  "has_merged_pr" => merged_pr?(pr_info),
  "current_pr" => pr_info,
  "has_task" => file_exists(".ai/codex-task.md"),
  "has_issue" => file_exists(".ai/issue.json"),
  "has_selected_issue" => file_exists(".ai/selected-issue.json"),
  "has_codex_report" => file_exists(".ai/codex-report.md"),
  "has_ci_status" => file_exists(".ai/ci-status.json"),
  "ci_green" => ci_green?(ci_status),
  "task_matches_current_branch" => task_matches_current_branch?(selected_issue, current_branch),
  "has_pr_url" => file_exists(".ai/pr-url.txt"),
  "pr_url" => read(".ai/pr-url.txt").strip,
  "selected_issue" => selected_issue
}

write(".ai/continue/state.json", JSON.pretty_generate(state))

action, reason = determine_action(
  pr_info: pr_info,
  selected_issue: selected_issue,
  ci_status: ci_status,
  current_branch: current_branch,
  has_task: state["has_task"],
  has_report: state["has_codex_report"],
  has_pr_url: state["has_pr_url"]
)

unless ACTIONS.include?(action)
  abort "Invalid action: #{action}"
end

write(
  ".ai/continue/decision.json",
  JSON.pretty_generate(
    {
      "action" => action,
      "reason" => reason
    }
  )
)

puts "Selected next action: #{action}"
puts "Reason: #{reason}"
puts

case action
when "merge_reviewed_pr"
  abort "Missing executable script: ./scripts/codex-merge-reviewed-pr" unless File.executable?("./scripts/codex-merge-reviewed-pr")

  system("./scripts/codex-merge-reviewed-pr") || abort("Merge script failed.")

  puts
  puts "Merge script succeeded. Picking next ticket..."
  system("./scripts/codex-pick-next-ticket") || abort("Pick next ticket script failed.")

  puts
  puts "Next step for Codex:"
  puts "Read .ai/codex-task.md and implement the selected issue."

when "pick_next_ticket"
  abort "Missing executable script: ./scripts/codex-pick-next-ticket" unless File.executable?("./scripts/codex-pick-next-ticket")

  system("./scripts/codex-pick-next-ticket") || abort("Pick next ticket script failed.")

  puts
  puts "Next step for Codex:"
  puts "Read .ai/codex-task.md and implement the selected issue."

when "continue_implementation"
  puts "Continue implementing the active task."
  puts "Read:"
  puts "- .ai/codex-task.md"
  puts "- .ai/selected-issue.json"
  puts "- .ai/issue.json"
  puts
  puts "When done, write .ai/codex-report.md and run ./scripts/codex-run-local-ci."

when "run_ci"
  abort "Missing executable script: ./scripts/codex-run-local-ci" unless File.executable?("./scripts/codex-run-local-ci")

  system("./scripts/codex-run-local-ci") || begin
    puts
    puts "Local CI failed."
    puts "Next step for Codex:"
    puts "Read .ai/ci-summary.md and .ai/codex-next-step.md, fix the smallest remaining issue, then rerun ./scripts/codex-run-local-ci."
    exit 1
  end

  puts
  puts "Local CI passed."
  puts "Next step for Codex:"
  puts "Run ./scripts/codex-create-draft-pr."

when "create_draft_pr"
  abort "Missing executable script: ./scripts/codex-create-draft-pr" unless File.executable?("./scripts/codex-create-draft-pr")

  system("./scripts/codex-create-draft-pr") || abort("Create draft PR script failed.")

  puts
  puts "Draft PR URL:"
  puts read(".ai/pr-url.txt").strip
  puts
  puts "Show this link to the user and stop."

when "show_pr_link"
  pr_url = read(".ai/pr-url.txt").strip
  abort "No .ai/pr-url.txt found." if pr_url.empty?

  puts "Draft PR URL:"
  puts pr_url
  puts
  puts "Show this link to the user and stop."

when "stop"
  puts "Workflow stopped."
  exit 1
end
