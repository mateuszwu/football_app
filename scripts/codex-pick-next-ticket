#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "fileutils"
require "open3"

ISSUE_LIMIT = ENV.fetch("ISSUE_LIMIT", "200").to_i
MAIN_BRANCH = ENV.fetch("MAIN_BRANCH", "main")

AI_DIR = ".ai"
FileUtils.mkdir_p(AI_DIR)

def require_tool!(name)
  system("command -v #{name} >/dev/null 2>&1") || abort("Missing required tool: #{name}")
end

%w[git gh ruby].each { |tool| require_tool!(tool) }

def write(path, content)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, content)
end

def read(path)
  File.exist?(path) ? File.read(path) : ""
end

def sh!(*args)
  stdout, stderr, status = Open3.capture3(*args)

  unless status.success?
    abort <<~MSG
      Command failed:
      #{args.join(" ")}

      STDERR:
      #{stderr}
    MSG
  end

  stdout
end

def label_names(issue)
  Array(issue["labels"]).map { |label| label["name"].to_s.strip }
end

def normalized_labels(issue)
  label_names(issue).map(&:downcase)
end

def milestone_title(issue)
  issue.dig("milestone", "title").to_s.strip
end

def extract_mvp_from_text(text)
  return nil if text.nil?

  patterns = [
    /\bMVP\s*(\d+)\b/i,
    /\bMVP[\s:_#-]+(\d+)\b/i
  ]

  patterns.each do |pattern|
    match = text.match(pattern)
    return match[1].to_i if match
  end

  nil
end

def extract_mvp_number(issue)
  milestone = milestone_title(issue)
  from_milestone = extract_mvp_from_text(milestone)
  return [ from_milestone, "milestone" ] if from_milestone

  labels_text = label_names(issue).join(" ")
  from_labels = extract_mvp_from_text(labels_text)
  return [ from_labels, "labels" ] if from_labels

  title = issue["title"].to_s
  from_title = extract_mvp_from_text(title)
  return [ from_title, "title" ] if from_title

  body = issue["body"].to_s
  from_body = extract_mvp_from_text(body)
  return [ from_body, "body" ] if from_body

  [ nil, nil ]
end

def preferred_score(issue)
  labels = normalized_labels(issue)
  title = issue["title"].to_s
  body = issue["body"].to_s

  score = 0

  score += 30 if labels.include?("ai-ok")
  score += 30 if labels.include?("ai-ready") || labels.include?("ai ready")
  score += 20 if labels.include?("small")
  score += 15 if labels.include?("bug")
  score += 12 if labels.include?("good-first-issue") || labels.include?("good first issue")
  score += 8 if labels.include?("feature")
  score += 6 if labels.include?("todo")

  score += 6 if body.length >= 80
  score += 6 if body.match?(/acceptance|criteria|expected|actual|steps|repro|should|when|then/i)
  score += 4 if body.match?(/`[^`]+`|```|\.rb|spec\/|app\/|controller|model|service|view/i)

  score -= 8 if title.match?(/refactor|redesign|architecture|rework|rewrite/i)
  score -= 5 if body.length > 8_000

  score
end

def complexity_label(issue)
  title = issue["title"].to_s
  body = issue["body"].to_s
  labels = normalized_labels(issue)

  return "high" if title.match?(/refactor|redesign|architecture|rewrite/i)
  return "high" if body.length > 8_000
  return "medium" if labels.any? { |label| %w[migration auth security billing deploy].include?(label) }
  return "medium" if body.length > 3_000

  "low"
end

def slugify(text)
  text
    .downcase
    .gsub(/[^a-z0-9]+/, "-")
    .gsub(/^-|-$/, "")
    .split("-")
    .first(7)
    .join("-")
end

def branch_name_for(issue_number, title)
  "ai/#{issue_number}-#{slugify(title)}"
end

def local_branch_exists?(branch_name)
  system("git", "show-ref", "--verify", "--quiet", "refs/heads/#{branch_name}")
end

def issue_to_candidate(issue)
  mvp, mvp_source = extract_mvp_number(issue)

  {
    "number" => issue["number"],
    "title" => issue["title"],
    "body" => issue["body"].to_s[0, 1_500],
    "url" => issue["url"],
    "labels" => label_names(issue),
    "assignees" => Array(issue["assignees"]).map { |a| a["login"] || a["name"] }.compact,
    "milestone" => milestone_title(issue),
    "mvp" => mvp,
    "mvp_source" => mvp_source,
    "updatedAt" => issue["updatedAt"],
    "preferred_score" => preferred_score(issue),
    "complexity" => complexity_label(issue),
    "branch" => branch_name_for(issue["number"], issue["title"])
  }
end

puts "Fetching up to #{ISSUE_LIMIT} open GitHub issues..."

raw_json = sh!(
  "gh",
  "issue",
  "list",
  "--state",
  "open",
  "--limit",
  ISSUE_LIMIT.to_s,
  "--json",
  "number,title,body,labels,assignees,milestone,updatedAt,url"
)

write(".ai/issues-raw.json", raw_json)

issues = JSON.parse(raw_json)
all_candidates = issues.map { |issue| issue_to_candidate(issue) }

write(".ai/issues-with-mvp-analysis.json", JSON.pretty_generate(all_candidates))

eligible = all_candidates.select { |candidate| candidate["mvp"] }

if eligible.empty?
  abort <<~MSG
    No MVP issues found.

    Expected MVP number in:
    - GitHub milestone title, e.g. "MVP 1 - Admin and players"
    - or labels/title/body as fallback
  MSG
end

lowest_mvp = eligible.map { |candidate| candidate["mvp"] }.min

lowest_mvp_candidates = eligible
  .select { |candidate| candidate["mvp"] == lowest_mvp }
  .sort_by { |candidate| [ -candidate["preferred_score"], candidate["number"] ] }

branchable_candidates = lowest_mvp_candidates.reject do |candidate|
  local_branch_exists?(candidate["branch"])
end

write(".ai/lowest-mvp-candidates.json", JSON.pretty_generate(lowest_mvp_candidates))
write(".ai/lowest-mvp-branchable-candidates.json", JSON.pretty_generate(branchable_candidates))

meta = {
  "issue_limit" => ISSUE_LIMIT,
  "open_issues_seen" => issues.size,
  "eligible_mvp_issues" => eligible.size,
  "lowest_mvp" => lowest_mvp,
  "lowest_mvp_candidate_count" => lowest_mvp_candidates.size,
  "branchable_lowest_mvp_candidate_count" => branchable_candidates.size,
  "rule" => "Only issues from the lowest open MVP number are eligible. No labels are hard-blocked."
}

write(".ai/ticket-selection-meta.json", JSON.pretty_generate(meta))

puts
puts "Lowest MVP detected: MVP #{lowest_mvp}"
puts "Eligible issues in this MVP: #{lowest_mvp_candidates.size}"
puts
abort <<~MSG if branchable_candidates.empty?
  No branchable issues found in MVP #{lowest_mvp}.

  Every candidate in the current lowest MVP already has a local branch.
  Finish or delete one of those branches before picking another ticket.
MSG

selection = begin
  fallback = branchable_candidates.first
  {
    "action" => "select",
    "number" => fallback["number"],
    "mvp" => fallback["mvp"],
    "title" => fallback["title"],
    "complexity" => fallback["complexity"],
    "reason" => "Deterministic selection: highest scoring branchable issue from the lowest MVP.",
    "why_this_is_implementable" => "Selected by labels, body quality, preferred score, and branch availability within the lowest MVP.",
    "things_codex_should_verify" => [
      "Verify the issue requirements before editing.",
      "Inspect relevant files before implementing.",
      "Confirm that the selected issue belongs to the lowest open MVP."
    ],
    "branch_slug" => slugify(fallback["title"]),
    "commit_message" => "feat(ai-#{fallback["number"]}): #{fallback["title"].downcase[0, 80]}"
  }
end

selected_number = selection["number"].to_i
selected_candidate = branchable_candidates.find { |candidate| candidate["number"] == selected_number }

unless selected_candidate
  abort "Selected issue ##{selected_number} is not in the branchable lowest MVP candidates."
end

if selection["mvp"].to_i != lowest_mvp
  abort "Selected issue MVP #{selection["mvp"]} does not match lowest MVP #{lowest_mvp}."
end

branch_slug = selection["branch_slug"].to_s.strip
branch_slug = slugify(selected_candidate["title"]) if branch_slug.empty?

unless branch_slug.match?(/\A[a-z0-9]+(?:-[a-z0-9]+)*\z/)
  branch_slug = slugify(branch_slug)
end

branch_name = selected_candidate["branch"]

commit_message = selection["commit_message"].to_s.strip
if commit_message.empty?
  commit_message = "feat(ai-#{selected_number}): #{selected_candidate["title"].downcase[0, 80]}"
end

full_issue_json = sh!(
  "gh",
  "issue",
  "view",
  selected_number.to_s,
  "--json",
  "number,title,body,labels,assignees,milestone,comments,url"
)

write(".ai/issue.json", full_issue_json)

full_issue = JSON.parse(full_issue_json)

selected_output = selection.merge(
  "number" => selected_number,
  "title" => selected_candidate["title"],
  "url" => selected_candidate["url"],
  "mvp" => lowest_mvp,
  "milestone" => selected_candidate["milestone"],
  "mvp_source" => selected_candidate["mvp_source"],
  "branch" => branch_name,
  "branch_slug" => branch_slug,
  "commit_message" => commit_message
)

write(".ai/selected-issue.json", JSON.pretty_generate(selected_output))
write(".ai/branch.txt", "#{branch_name}\n")

labels = selected_candidate["labels"].join(", ")
body = full_issue["body"].to_s
comments = Array(full_issue["comments"]).first(5).map do |comment|
  author = comment.dig("author", "login") || "unknown"
  text = comment["body"].to_s[0, 600]
  "- #{author}: #{text}"
end.join("\n\n")

codex_task = <<~MD
  # Task for Codex

  ## GitHub issue

  - Number: ##{selected_number}
  - Title: #{selected_candidate["title"]}
  - URL: #{selected_candidate["url"]}
  - MVP: #{lowest_mvp}
  - Milestone: #{selected_candidate["milestone"]}
  - Branch: `#{branch_name}`
  - Complexity: #{selection["complexity"] || selected_candidate["complexity"]}

  ## Selection reason

  #{selection["reason"]}

  ## Why this is implementable

  #{selection["why_this_is_implementable"]}

  ## Labels

  #{labels}

  ## Issue description

  #{body[0, 6_000]}

  ## Issue comments

  #{comments.empty? ? "No comments." : comments}

  ## Things Codex should verify before coding

  #{Array(selection["things_codex_should_verify"]).map { |item| "- #{item}" }.join("\n")}

  ## Instructions for Codex

  Implement this issue.

  Rules:
  - Use the existing Codex Notes workflow.
  - Verify the issue yourself before editing.
  - Make the smallest correct change that completes the issue.
  - Add or update tests.
  - Run local validation:
    - `bundle exec rspec`
    - `bin/rubocop`
    - `bin/brakeman --no-pager`
  - Prefer Rails controller style from Codex Notes:
    - load records inside actions when practical
    - render with explicit locals
    - use service objects for non-trivial create/update persistence
  - Keep ActiveRecord models lean.
  - Use query objects for read-focused ranking/data shaping.
  - Open a draft PR after implementation.
  - Do not merge.

  ## PR requirements

  - Draft PR.
  - Body should include:
    - issue link
    - summary
    - tests run
    - risk/complexity notes
  - Use title style:
    - `feat(ai-#{selected_number}): short title`
MD

write(".ai/codex-task.md", codex_task)

puts "Preparing fresh branch from latest #{MAIN_BRANCH}..."

unless system("git diff --quiet") && system("git diff --cached --quiet")
  abort <<~MSG
    Working tree is not clean. Commit or stash changes before creating a new branch.

    Current status:
    #{`git status --short`}
  MSG
end

current_branch = `git branch --show-current`.strip

sh!("git", "switch", MAIN_BRANCH) unless current_branch == MAIN_BRANCH
sh!("git", "pull", "--ff-only")

existing_branch = `git branch --list #{branch_name}`.strip

unless existing_branch.empty?
  abort <<~MSG
    Branch already exists: #{branch_name}

    Refusing to overwrite an existing branch.
    Delete it manually if you want to recreate it:

    git branch -D #{branch_name}
  MSG
end

sh!("git", "switch", "-c", branch_name)

puts
puts "Selected issue:"
puts "---------------"
puts "Issue:      ##{selected_number}"
puts "Title:      #{selected_candidate["title"]}"
puts "MVP:        #{lowest_mvp}"
puts "Milestone:  #{selected_candidate["milestone"]}"
puts "Complexity: #{selection["complexity"] || selected_candidate["complexity"]}"
puts "Branch:     #{branch_name}"
puts
puts "Files written:"
puts "- .ai/ticket-selection-meta.json"
puts "- .ai/lowest-mvp-candidates.json"
puts "- .ai/selected-issue.json"
puts "- .ai/issue.json"
puts "- .ai/branch.txt"
puts "- .ai/codex-task.md"
puts
puts "Branch created from latest #{MAIN_BRANCH}."
puts
puts "Next step for Codex:"
puts "Read .ai/codex-task.md and implement the issue."
