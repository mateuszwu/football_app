def tail(text, lines = 350)
  text.lines.last(lines).join
end

def grep_blocks(text, patterns, context: 3, max_blocks: 80)
  regexes = patterns.map { |pattern| Regexp.new(pattern, Regexp::IGNORECASE) }
  lines = text.lines
  blocks = []
  used = {}

  lines.each_with_index do |line, index|
    next unless regexes.any? { |regex| line.match?(regex) }

    from = [ 0, index - context ].max
    to = [ lines.length - 1, index + context ].min
    key = [ from, to ]

    next if used[key]

    used[key] = true

    block = (from..to).map { |i| "#{i + 1}: #{lines[i]}" }.join
    blocks << block

    break if blocks.size >= max_blocks
  end

  blocks.join("\n\n---\n\n")
end

def run_check(name, command, ci_dir)
  puts
  puts "==> Running #{name}"
  puts "Command: #{command}"

  log_path = File.join(ci_dir, "#{name}.log")
  result = run_capture(command, log_path)

  write(File.join(ci_dir, "#{name}.status"), result[:exit_code].to_s)
  write(File.join(ci_dir, "#{name}.duration"), result[:duration_seconds].to_s)
  write(File.join(ci_dir, "#{name}.command"), command)

  if result[:passed]
    puts "PASS #{name}"
  else
    puts "FAIL #{name} with status #{result[:exit_code]}"
  end

  result
end

