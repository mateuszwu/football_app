summary_prompt = <<~PROMPT
  You are a local CI result summarizer for Codex.

  Read:
  - .ai/ci/latest/status.json
  - .ai/ci/latest/git-status-before.txt
  - .ai/ci/latest/git-status-after-rubocop-autocorrect.txt
  - .ai/ci/latest/rubocop-autocorrect-changed-files.txt
  - .ai/ci/latest/rubocop-autocorrect-diff-stat.txt
  - .ai/ci/latest/git-status-after.txt
  - .ai/ci/latest/diff-stat-after.txt
  - .ai/ci/latest/changed-files-after.txt
  - .ai/ci/latest/llm-input.md
  - .ai/ci/latest/extracted/rspec-important.log
  - .ai/ci/latest/extracted/rubocop_autocorrect-important.log
  - .ai/ci/latest/extracted/rubocop-important.log
  - .ai/ci/latest/extracted/brakeman-important.log
  - tail logs only if important logs are insufficient

  Your job:
  Summarize local CI results for Codex.

  Important RuboCop rule:
  RuboCop autocorrect has already been run.
  Codex should only fix remaining RuboCop offenses from the final `bin/rubocop` run.
  Codex should not manually fix formatting/style that autocorrect already handled.
  If RuboCop autocorrect changed files, mention that they should be included in the PR if related to the implementation.

  Hard rules:
  - Do not invent failures.
  - Use only information from the files above.
  - If evidence is missing or unclear, say so.
  - Group related failures.
  - Ignore noise unless it affects the fix.
  - Do not suggest broad rewrites.
  - Do not edit files.
  - Do not weaken tests.
  - Prefer fixing implementation over changing specs, unless the test is clearly outdated by the issue requirements.

  Write a concise markdown report with exactly this structure:

  # Local CI summary for Codex

  ## Overall result
  passed|failed|unknown

  ## Commands run
  - rspec:
  - rubocop autocorrect:
  - rubocop final:
  - brakeman:

  ## RuboCop autocorrect result
  - status:
  - files changed by autocorrect:
  - remaining action for Codex:

  ## RSpec result
  - status:
  - failure groups:
  - likely relevant files:
  - recommended next step:

  ## RuboCop final result
  - status:
  - remaining offenses:
  - autofix already attempted:
  - recommended next step:

  ## Brakeman result
  - status:
  - warnings:
  - severity:
  - recommended next step:

  ## Changed files / scope
  - changed files:
  - scope risk:

  ## What Codex should do next
  Concrete numbered steps.

  ## What Codex should avoid
  Concrete bullets.

  ## Full logs available
  - .ai/ci/latest/rspec.log
  - .ai/ci/latest/rubocop_autocorrect.log
  - .ai/ci/latest/rubocop.log
  - .ai/ci/latest/brakeman.log
PROMPT

summary_prompt_path = File.join(CI_DIR, "summary-prompt.md")
write(summary_prompt_path, summary_prompt)

puts
puts "Running local LLM CI summarizer..."

summary_command = [
  "pi",
  "--model", MODEL,
  "--tools", "read,bash,grep,find,ls",
  "--mode", "print"
]

stdout, stderr, pi_status = Open3.capture3(*summary_command, stdin_data: summary_prompt)

write(File.join(CI_DIR, "summary.md"), stdout)
write(File.join(CI_DIR, "summary.stderr.log"), stderr)

unless pi_status.success?
  warn "Pi summarizer failed with status #{pi_status.exitstatus}"
  warn stderr.lines.last(80).join

  fallback = <<~MD
    # Local CI summary for Codex

    ## Overall result
    #{status.dig("overall", "passed") ? "passed" : "failed"}

    ## Commands run
    - rspec: bundle exec rspec
    - rubocop autocorrect: #{autocorrect_cmd}
    - rubocop final: bin/rubocop
    - brakeman: bin/brakeman --no-pager

    ## RuboCop autocorrect result
    - status: #{status.dig("rubocop_autocorrect", "passed") ? "passed" : "failed/non-zero"}
    - files changed by autocorrect:
    #{read(File.join(CI_DIR, "rubocop-autocorrect-changed-files.txt")).lines.map { |line| "  - #{line.strip}" }.join("\n")}
    - remaining action for Codex: inspect final RuboCop output only if final RuboCop failed.

    ## RSpec result
    - status: #{status.dig("rspec", "passed") ? "passed" : "failed"}
    - failure groups: local LLM summary failed; inspect .ai/ci/latest/extracted/rspec-important.log
    - likely relevant files: unknown
    - recommended next step: inspect extracted RSpec logs

    ## RuboCop final result
    - status: #{status.dig("rubocop", "passed") ? "passed" : "failed"}
    - remaining offenses: local LLM summary failed; inspect .ai/ci/latest/extracted/rubocop-important.log
    - autofix already attempted: yes
    - recommended next step: fix only remaining final RuboCop offenses

    ## Brakeman result
    - status: #{status.dig("brakeman", "passed") ? "passed" : "failed"}
    - warnings: local LLM summary failed; inspect .ai/ci/latest/extracted/brakeman-important.log
    - severity: unknown
    - recommended next step: inspect extracted Brakeman logs

    ## Changed files / scope
    - changed files:
    #{read(File.join(CI_DIR, "changed-files-after.txt")).lines.map { |line| "  - #{line.strip}" }.join("\n")}
    - scope risk: unknown

    ## What Codex should do next
    1. Read extracted logs from .ai/ci/latest/extracted/.
    2. Fix only failures left after autocorrect.
    3. Re-run ./scripts/codex-run-local-ci.

    ## What Codex should avoid
    - Do not manually fix RuboCop offenses that autocorrect already handled.
    - Do not read full logs unless extracted logs are insufficient.
    - Do not broaden scope.
    - Do not weaken tests without clear justification.

    ## Full logs available
    - .ai/ci/latest/rspec.log
    - .ai/ci/latest/rubocop_autocorrect.log
    - .ai/ci/latest/rubocop.log
    - .ai/ci/latest/brakeman.log
  MD

  write(File.join(CI_DIR, "summary.md"), fallback)
end

next_step = <<~MD
  # Next step for Codex

  Read:

  - .ai/ci/latest/summary.md
  - .ai/ci/latest/status.json
  - .ai/ci/latest/extracted/rspec-important.log if RSpec failed
  - .ai/ci/latest/extracted/rubocop-important.log if final RuboCop failed
  - .ai/ci/latest/extracted/brakeman-important.log if Brakeman failed

  RuboCop autocorrect has already been run.

  If CI failed:
  - Fix only the failures that remain after autocorrect.
  - Do not manually fix formatting/style already handled by RuboCop autocorrect.
  - Do not broaden scope.
  - Do not weaken tests unless clearly justified.
  - Prefer fixing implementation over changing specs.
  - Re-run `./scripts/codex-run-local-ci`.

  If CI passed:
  - Include RuboCop autocorrect changes in the PR if they are related.
  - Update `.ai/codex-report.md`.
  - Run `./scripts/codex-create-pr` dry run.
MD

write(File.join(CI_DIR, "codex-next-step.md"), next_step)

FileUtils.cp(File.join(CI_DIR, "summary.md"), ".ai/ci-summary.md")
FileUtils.cp(File.join(CI_DIR, "codex-next-step.md"), ".ai/codex-next-step.md")
FileUtils.cp(File.join(CI_DIR, "status.json"), ".ai/ci-status.json")

puts
puts "Local CI summary:"
puts "-----------------"
puts read(File.join(CI_DIR, "summary.md"))

puts
puts "Files written:"
puts "- #{File.join(CI_DIR, "status.json")}"
puts "- #{File.join(CI_DIR, "summary.md")}"
puts "- #{File.join(CI_DIR, "codex-next-step.md")}"
puts "- .ai/ci-summary.md"
puts "- .ai/codex-next-step.md"
puts "- .ai/ci-status.json"

exit(status.dig("overall", "passed") ? 0 : 1)
