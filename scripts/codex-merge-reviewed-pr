#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"
require "fileutils"

MAIN_BRANCH = ENV.fetch("MAIN_BRANCH", "main")

def require_tool!(name)
  system("command -v #{name} >/dev/null 2>&1") || abort("Missing required tool: #{name}")
end

%w[git gh ruby].each { |tool| require_tool!(tool) }

def sh(*args)
  stdout, stderr, status = Open3.capture3(*args)

  {
    stdout: stdout,
    stderr: stderr,
    success: status.success?,
    exit_code: status.exitstatus
  }
end

def sh!(*args)
  result = sh(*args)

  unless result[:success]
    abort <<~MSG
      Command failed:
      #{args.join(" ")}

      STDERR:
      #{result[:stderr]}
    MSG
  end

  result[:stdout]
end

def json_from_command!(*args)
  JSON.parse(sh!(*args))
rescue JSON::ParserError => e
  abort "Invalid JSON from command #{args.join(" ")}: #{e.message}"
end

def write(path, content)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, content)
end

def working_tree_clean?
  sh!("git", "status", "--short").strip.empty?
end

def current_branch
  sh!("git", "branch", "--show-current").strip
end

def current_pr
  result = sh(
    "gh",
    "pr",
    "view",
    "--json",
    "number,state,isDraft,mergeStateStatus,statusCheckRollup,url,headRefName,baseRefName"
  )

  return nil unless result[:success]
  return nil if result[:stdout].strip.empty?

  JSON.parse(result[:stdout])
rescue JSON::ParserError
  nil
end

def sync_main_branch!
  remote_ref = "origin/#{MAIN_BRANCH}"

  puts "Fetching latest #{remote_ref}..."
  sh!("git", "fetch", "origin", MAIN_BRANCH)

  puts "Switching to #{MAIN_BRANCH}..."
  sh!("git", "switch", MAIN_BRANCH)

  puts "Resetting local #{MAIN_BRANCH} to #{remote_ref}..."
  sh!("git", "reset", "--hard", remote_ref)
end

def checks_summary(status_check_rollup)
  Array(status_check_rollup).map do |check|
    {
      "name" => check["name"] || check["context"] || check["workflowName"],
      "status" => check["status"],
      "conclusion" => check["conclusion"],
      "detailsUrl" => check["detailsUrl"]
    }
  end
end

def checks_green?(status_check_rollup)
  checks = Array(status_check_rollup)

  # If there are no checks configured, do not block.
  return true if checks.empty?

  checks.all? do |check|
    status = check["status"].to_s.upcase
    conclusion = check["conclusion"].to_s.upcase

    [ "COMPLETED", "SUCCESS" ].include?(status) ||
      [ "SUCCESS", "NEUTRAL", "SKIPPED" ].include?(conclusion)
  end
end

puts "Preparing to merge reviewed PR..."

branch_before_merge = current_branch

if branch_before_merge == MAIN_BRANCH
  abort <<~MSG
    You are on #{MAIN_BRANCH}. Switch to a PR branch before running this script.

    Current branch:
    #{branch_before_merge}
  MSG
end

unless working_tree_clean?
  abort <<~MSG
    Working tree is not clean. Commit or stash changes before merging.

    Current status:
    #{sh!("git", "status", "--short")}
  MSG
end

pr = current_pr

unless pr
  abort <<~MSG
    No current PR found for branch #{branch_before_merge}.

    Check:
    gh pr view
  MSG
end

pr_number = pr.fetch("number")
pr_url = pr.fetch("url")
head_ref = pr.fetch("headRefName")
base_ref = pr.fetch("baseRefName")
is_draft = pr.fetch("isDraft")
state = pr.fetch("state")
merge_state = pr["mergeStateStatus"]

if base_ref != MAIN_BRANCH
  abort <<~MSG
    PR base branch is not #{MAIN_BRANCH}.

    PR: #{pr_url}
    Base: #{base_ref}
  MSG
end

if state != "OPEN"
  abort <<~MSG
    PR is not open.

    PR: #{pr_url}
    State: #{state}
  MSG
end

puts "PR: ##{pr_number}"
puts "URL: #{pr_url}"
puts "Head: #{head_ref}"
puts "Base: #{base_ref}"
puts "Draft: #{is_draft}"
puts "Merge state: #{merge_state}"
puts

write(".ai/merge/pr-before.json", JSON.pretty_generate(pr))
write(".ai/merge/checks-before.json", JSON.pretty_generate(checks_summary(pr["statusCheckRollup"])))

unless checks_green?(pr["statusCheckRollup"])
  puts "PR checks are not green:"
  puts JSON.pretty_generate(checks_summary(pr["statusCheckRollup"]))
  abort "Refusing to merge until checks are green."
end

if is_draft
  puts "Marking draft PR as ready..."
  sh!("gh", "pr", "ready", pr_number.to_s)
end

# Refresh PR state after marking ready.
pr = json_from_command!(
  "gh",
  "pr",
  "view",
  pr_number.to_s,
  "--json",
  "number,state,isDraft,mergeStateStatus,statusCheckRollup,url,headRefName,baseRefName"
)

write(".ai/merge/pr-after-ready.json", JSON.pretty_generate(pr))
write(".ai/merge/checks-after-ready.json", JSON.pretty_generate(checks_summary(pr["statusCheckRollup"])))

if pr["isDraft"]
  abort <<~MSG
    PR is still draft after gh pr ready.

    PR: #{pr_url}
  MSG
end

unless checks_green?(pr["statusCheckRollup"])
  puts "PR checks are not green after ready:"
  puts JSON.pretty_generate(checks_summary(pr["statusCheckRollup"]))
  abort "Refusing to merge until checks are green."
end

merge_state = pr["mergeStateStatus"]

if merge_state && !%w[CLEAN HAS_HOOKS UNKNOWN UNSTABLE].include?(merge_state)
  abort <<~MSG
    PR merge state is not acceptable.

    Merge state: #{merge_state}
    PR: #{pr_url}
  MSG
end

puts "Merging PR ##{pr_number}..."
sh!("gh", "pr", "merge", pr_number.to_s, "--squash", "--delete-branch")

sync_main_branch!

# Remove local branch if it still exists.
if sh("git", "show-ref", "--verify", "--quiet", "refs/heads/#{branch_before_merge}")[:success]
  puts "Deleting local branch #{branch_before_merge}..."
  delete_result = sh("git", "branch", "-d", branch_before_merge)

  unless delete_result[:success]
    puts "Could not delete branch with -d. Trying -D..."
    sh!("git", "branch", "-D", branch_before_merge)
  end
end

write(".ai/merge/merged-pr-url.txt", "#{pr_url}\n")
write(".ai/merge/merged-pr-number.txt", "#{pr_number}\n")

puts
puts "Merged PR:"
puts pr_url
puts
puts "Local #{MAIN_BRANCH} is updated."
puts "Deleted branch:"
puts branch_before_merge
