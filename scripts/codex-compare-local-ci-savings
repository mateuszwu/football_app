#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "fileutils"
require "open3"
require "time"

MODEL = ENV.fetch("LOCAL_LLM_MODEL", "lmstudio/qwen/qwen3.5-9b")
TOKEN_ENCODING = ENV.fetch("TOKEN_ENCODING", "o200k_base")

RUN_ID = Time.now.strftime("%Y%m%d-%H%M%S")
BASE_DIR = File.join(".ai", "experiments", "ci-token-savings", RUN_ID)
BASELINE_DIR = File.join(BASE_DIR, "baseline")
OPTIMIZED_DIR = File.join(BASE_DIR, "optimized")

FileUtils.mkdir_p(BASELINE_DIR)
FileUtils.mkdir_p(OPTIMIZED_DIR)

def require_tool!(name)
  system("command -v #{name} >/dev/null 2>&1") || abort("Missing required tool: #{name}")
end

%w[git ruby pi].each { |tool| require_tool!(tool) }

def write(path, content)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, content)
end

def read(path)
  File.exist?(path) ? File.read(path) : ""
end

def run_capture(command, log_path)
  started_at = Time.now
  stdout, stderr, status = Open3.capture3(command)
  write(log_path, stdout + stderr)

  {
    command: command,
    exit_code: status.exitstatus,
    passed: status.success?,
    duration_seconds: (Time.now - started_at).round,
    log_file: log_path
  }
end

def tail(text, lines = 350)
  text.lines.last(lines).join
end

def grep_blocks(text, patterns, context: 3, max_blocks: 80)
  regexes = patterns.map { |pattern| Regexp.new(pattern, Regexp::IGNORECASE) }
  lines = text.lines
  blocks = []
  used = {}

  lines.each_with_index do |line, index|
    next unless regexes.any? { |regex| line.match?(regex) }

    from = [ 0, index - context ].max
    to = [ lines.length - 1, index + context ].min
    key = [ from, to ]

    next if used[key]

    used[key] = true

    block = (from..to).map { |i| "#{i + 1}: #{lines[i]}" }.join
    blocks << block

    break if blocks.size >= max_blocks
  end

  blocks.join("\n\n---\n\n")
end

def command_available?(cmd)
  system("command -v #{cmd} >/dev/null 2>&1")
end

def count_tokens_with_tiktoken(text, encoding)
  script = <<~PY
    import sys
    import tiktoken

    encoding = sys.argv[1]
    text = sys.stdin.read()

    enc = tiktoken.get_encoding(encoding)
    print(len(enc.encode(text)))
  PY

  stdout, stderr, status = Open3.capture3(
    "python3",
    "-c",
    script,
    encoding,
    stdin_data: text
  )

  raise "tiktoken failed: #{stderr}" unless status.success?

  stdout.to_i
end

def count_tokens_estimate(text)
  # Fallback approximation if tiktoken is unavailable.
  # Good enough for relative A/B comparison.
  (text.length / 4.0).ceil
end

def count_tokens(text, encoding)
  if command_available?("python3")
    begin
      return count_tokens_with_tiktoken(text, encoding)
    rescue StandardError
      # fallback below
    end
  end

  count_tokens_estimate(text)
end

def concat_named_files(files)
  files.map do |path|
    next "" unless File.exist?(path)

    <<~TEXT
      ===== FILE: #{path} =====

      #{File.read(path)}
    TEXT
  end.join("\n\n")
end

def extract_logs(run_dir, results)
  extracted_dir = File.join(run_dir, "extracted")
  FileUtils.mkdir_p(extracted_dir)

  patterns = {
    "rspec" => [
      "Failures:",
      "^\\s*\\d+\\)",
      "Failure/Error:",
      "expected:",
      "got:",
      "Diff:",
      "# ./",
      "Finished in",
      "\\d+ examples?, \\d+ failures?",
      "Randomized with seed",
      "Error:",
      "Exception"
    ],
    "rubocop" => [
      "Offenses:",
      "Inspecting",
      "^\\S+:\\d+:\\d+:",
      "convention:",
      "warning:",
      "error:",
      "fatal:",
      "\\d+ files inspected"
    ],
    "brakeman" => [
      "Confidence:",
      "Warning Type:",
      "Message:",
      "File:",
      "Line:",
      "Code:",
      "No warnings found",
      "Security Warnings",
      "Scan Information"
    ]
  }

  results.each do |name, result|
    log = read(result[:log_file])

    write(File.join(extracted_dir, "#{name}-tail.log"), tail(log, 350))
    write(
      File.join(extracted_dir, "#{name}-important.log"),
      grep_blocks(log, patterns.fetch(name), context: 3)
    )
  end

  extracted_dir
end

def run_ci(run_dir)
  checks = {
    "rspec" => "bundle exec rspec",
    "rubocop" => "bin/rubocop",
    "brakeman" => "bin/brakeman --no-pager"
  }

  write(File.join(run_dir, "git-status.txt"), `git status --short --branch`)
  write(File.join(run_dir, "diff-stat.txt"), `git diff --stat`)
  write(File.join(run_dir, "changed-files.txt"), `git diff --name-only`)

  results = {}

  checks.each do |name, command|
    puts
    puts "==> Running #{name}"
    puts "Command: #{command}"

    result = run_capture(command, File.join(run_dir, "#{name}.log"))
    results[name] = result

    write(File.join(run_dir, "#{name}.status"), result[:exit_code].to_s)
    write(File.join(run_dir, "#{name}.duration"), result[:duration_seconds].to_s)

    if result[:passed]
      puts "PASS #{name}"
    else
      puts "FAIL #{name} with status #{result[:exit_code]}"
    end
  end

  status = results.transform_values do |result|
    {
      "exit_code" => result[:exit_code],
      "duration_seconds" => result[:duration_seconds],
      "passed" => result[:passed],
      "log_file" => result[:log_file]
    }
  end

  status["overall"] = {
    "passed" => results.values.all? { |result| result[:passed] }
  }

  write(File.join(run_dir, "status.json"), JSON.pretty_generate(status))

  extracted_dir = extract_logs(run_dir, results)

  [ checks, results, status, extracted_dir ]
end

def build_baseline_prompt(run_dir, mode)
  files =
    case mode
    when "full"
      [
        File.join(run_dir, "rspec.log"),
        File.join(run_dir, "rubocop.log"),
        File.join(run_dir, "brakeman.log")
      ]
    when "tail"
      [
        File.join(run_dir, "extracted", "rspec-tail.log"),
        File.join(run_dir, "extracted", "rubocop-tail.log"),
        File.join(run_dir, "extracted", "brakeman-tail.log")
      ]
    else
      [
        File.join(run_dir, "extracted", "rspec-important.log"),
        File.join(run_dir, "extracted", "rubocop-important.log"),
        File.join(run_dir, "extracted", "brakeman-important.log")
      ]
    end

  <<~PROMPT
    You are Codex.

    Analyze the local CI output below and decide what to fix next.

    Rules:
    - Fix the smallest failing issue.
    - Do not broaden scope.
    - Do not weaken tests without clear justification.
    - Prefer fixing implementation over changing specs.
    - Do not modify secrets, deployment, release, billing, or security-sensitive files.

    #{concat_named_files(files)}
  PROMPT
end

def build_optimized_summary(run_dir, model)
  llm_input = +"# Local CI raw overview\n\n"

  %w[rspec rubocop brakeman].each do |name|
    status = read(File.join(run_dir, "#{name}.status")).strip
    duration = read(File.join(run_dir, "#{name}.duration")).strip

    llm_input << "## #{name}\n"
    llm_input << "- exit_code: #{status}\n"
    llm_input << "- passed: #{status == "0"}\n"
    llm_input << "- duration_seconds: #{duration}\n\n"
    llm_input << "### important extract\n"
    llm_input << read(File.join(run_dir, "extracted", "#{name}-important.log"))[0, 20_000]
    llm_input << "\n\n"
  end

  llm_input << "## Git status\n"
  llm_input << read(File.join(run_dir, "git-status.txt"))
  llm_input << "\n\n"

  llm_input << "## Diff stat\n"
  llm_input << read(File.join(run_dir, "diff-stat.txt"))
  llm_input << "\n\n"

  llm_input << "## Changed files\n"
  llm_input << read(File.join(run_dir, "changed-files.txt"))
  llm_input << "\n\n"

  write(File.join(run_dir, "llm-input.md"), llm_input)

  prompt = <<~PROMPT
    You are a local CI result summarizer for Codex.

    Read the CI overview below.

    Hard rules:
    - Do not invent failures.
    - Use only information from the input.
    - If evidence is missing or unclear, say so.
    - Group related failures.
    - Ignore noise unless it affects the fix.
    - Do not suggest broad rewrites.
    - Do not weaken tests.
    - Prefer fixing implementation over changing specs, unless the test is clearly outdated by the issue requirements.

    Write a concise markdown report with exactly this structure:

    # Local CI summary for Codex

    ## Overall result
    passed|failed|unknown

    ## Commands run
    - rspec:
    - rubocop:
    - brakeman:

    ## RSpec result
    - status:
    - failure groups:
    - likely relevant files:
    - recommended next step:

    ## RuboCop result
    - status:
    - offenses:
    - autofixable:
    - recommended next step:

    ## Brakeman result
    - status:
    - warnings:
    - severity:
    - recommended next step:

    ## Changed files / scope
    - changed files:
    - scope risk:

    ## What Codex should do next
    Concrete numbered steps.

    ## What Codex should avoid
    Concrete bullets.

    CI overview:

    #{llm_input}
  PROMPT

  write(File.join(run_dir, "summary-prompt.md"), prompt)

  stdout, stderr, status = Open3.capture3(
    "pi",
    "--model", model,
    "--tools", "read,bash,grep,find,ls",
    "--mode", "print",
    stdin_data: prompt
  )

  write(File.join(run_dir, "summary.md"), stdout)
  write(File.join(run_dir, "summary.stderr.log"), stderr)

  unless status.success?
    fallback = <<~MD
      # Local CI summary for Codex

      ## Overall result
      unknown

      Local LLM summary failed.

      Use extracted logs:
      - #{File.join(run_dir, "extracted", "rspec-important.log")}
      - #{File.join(run_dir, "extracted", "rubocop-important.log")}
      - #{File.join(run_dir, "extracted", "brakeman-important.log")}
    MD

    write(File.join(run_dir, "summary.md"), fallback)
  end

  read(File.join(run_dir, "summary.md"))
end

def build_optimized_prompt(run_dir, summary)
  <<~PROMPT
    You are Codex.

    Analyze the local CI summary below and decide what to fix next.

    Rules:
    - First use the summary.
    - Read extracted logs only if the summary is insufficient.
    - Do not read full logs unless absolutely necessary.
    - Fix the smallest failing issue.
    - Do not broaden scope.
    - Do not weaken tests without clear justification.
    - Prefer fixing implementation over changing specs.
    - Do not modify secrets, deployment, release, billing, or security-sensitive files.

    ===== FILE: #{File.join(run_dir, "summary.md")} =====

    #{summary}
  PROMPT
end

def token_report(name, text, encoding)
  {
    name: name,
    chars: text.length,
    bytes: text.bytesize,
    tokens: count_tokens(text, encoding)
  }
end

def savings(base, opt)
  return nil if base[:tokens].zero?

  ((1.0 - opt[:tokens].to_f / base[:tokens].to_f) * 100.0).round(2)
end

def fmt_num(value)
  value.to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1_').reverse
end

def pct(value)
  return "n/a" if value.nil?

  "#{value.to_f.round(2)}%"
end

def pass_label(value)
  value ? "PASS" : "FAIL"
end

def status_value(status, check)
  status.dig(check, "passed") ||
    status.dig(check, :passed) ||
    false
end

def overall_value(status)
  status.dig("overall", "passed") ||
    status.dig("overall", :passed) ||
    false
end

def print_table(title, headers, rows)
  widths = headers.map(&:length)

  rows.each do |row|
    row.each_with_index do |cell, index|
      widths[index] = [ widths[index], cell.to_s.length ].max
    end
  end

  separator = "+" + widths.map { |width| "-" * (width + 2) }.join("+") + "+"

  puts
  puts title
  puts separator
  puts "| " + headers.each_with_index.map { |header, index| header.ljust(widths[index]) }.join(" | ") + " |"
  puts separator

  rows.each do |row|
    puts "| " + row.each_with_index.map { |cell, index| cell.to_s.ljust(widths[index]) }.join(" | ") + " |"
  end

  puts separator
end

puts "# Codex CI local LLM savings comparison"
puts
puts "Run ID: #{RUN_ID}"
puts
puts "This runs local CI twice:"
puts "- baseline run: no local LLM summary"
puts "- optimized run: local LLM summary"
puts

puts "Running baseline CI..."
_baseline_checks, _baseline_results, baseline_status, = run_ci(BASELINE_DIR)

puts
puts "Running optimized CI..."
_optimized_checks, _optimized_results, optimized_status, = run_ci(OPTIMIZED_DIR)

puts
puts "Building baseline prompts..."
baseline_full = build_baseline_prompt(BASELINE_DIR, "full")
baseline_tail = build_baseline_prompt(BASELINE_DIR, "tail")
baseline_important = build_baseline_prompt(BASELINE_DIR, "important")

write(File.join(BASELINE_DIR, "codex-prompt-full.md"), baseline_full)
write(File.join(BASELINE_DIR, "codex-prompt-tail.md"), baseline_tail)
write(File.join(BASELINE_DIR, "codex-prompt-important.md"), baseline_important)

puts "Building optimized local LLM summary..."
optimized_summary = build_optimized_summary(OPTIMIZED_DIR, MODEL)
optimized_prompt = build_optimized_prompt(OPTIMIZED_DIR, optimized_summary)

write(File.join(OPTIMIZED_DIR, "codex-prompt-summary.md"), optimized_prompt)

reports = [
  token_report("baseline_full_logs", baseline_full, TOKEN_ENCODING),
  token_report("baseline_tail_logs", baseline_tail, TOKEN_ENCODING),
  token_report("baseline_important_extracts", baseline_important, TOKEN_ENCODING),
  token_report("optimized_summary_only", optimized_prompt, TOKEN_ENCODING)
]

by_name = reports.to_h { |report| [ report[:name], report ] }

comparisons = [
  [ "baseline_full_logs", "optimized_summary_only" ],
  [ "baseline_tail_logs", "optimized_summary_only" ],
  [ "baseline_important_extracts", "optimized_summary_only" ]
].map do |base, opt|
  b = by_name.fetch(base)
  o = by_name.fetch(opt)

  {
    baseline: base,
    optimized: opt,
    baseline_tokens: b[:tokens],
    optimized_tokens: o[:tokens],
    savings_percent: savings(b, o)
  }
end

result = {
  run_id: RUN_ID,
  timestamp: Time.now.utc.iso8601,
  token_encoding: TOKEN_ENCODING,
  local_llm_model: MODEL,
  note: "This estimates Codex input token savings without calling Codex. It runs CI twice and compares raw/log prompts vs local LLM summary prompt.",
  baseline_status: baseline_status,
  optimized_status: optimized_status,
  token_reports: reports,
  comparisons: comparisons,
  paths: {
    baseline_dir: BASELINE_DIR,
    optimized_dir: OPTIMIZED_DIR
  }
}

write(File.join(BASE_DIR, "result.json"), JSON.pretty_generate(result))

best_comparison = comparisons.max_by { |comparison| comparison[:savings_percent].to_f }

baseline_overall = overall_value(baseline_status)
optimized_overall = overall_value(optimized_status)

md = +"# Codex CI local LLM savings comparison\n\n"
md << "- Run ID: `#{RUN_ID}`\n"
md << "- Token encoding: `#{TOKEN_ENCODING}`\n"
md << "- Local LLM model: `#{MODEL}`\n\n"

md << "## Summary\n\n"
md << "| Metric | Value |\n"
md << "|---|---:|\n"
md << "| Best savings | #{pct(best_comparison[:savings_percent])} |\n"
md << "| Best baseline | `#{best_comparison[:baseline]}` |\n"
md << "| Optimized variant | `#{best_comparison[:optimized]}` |\n"
md << "| Baseline CI | #{pass_label(baseline_overall)} |\n"
md << "| Optimized CI | #{pass_label(optimized_overall)} |\n\n"

md << "## Token comparison\n\n"
md << "| Baseline | Base tokens | Optimized | Opt tokens | Savings |\n"
md << "|---|---:|---|---:|---:|\n"

comparisons.each do |comparison|
  md << "| `#{comparison[:baseline]}` | #{fmt_num(comparison[:baseline_tokens])} | `#{comparison[:optimized]}` | #{fmt_num(comparison[:optimized_tokens])} | #{pct(comparison[:savings_percent])} |\n"
end

md << "\n## Token scenarios\n\n"
md << "| Scenario | Tokens | Chars | Bytes |\n"
md << "|---|---:|---:|---:|\n"

reports.sort_by { |report| report[:tokens] }.each do |report|
  md << "| `#{report[:name]}` | #{fmt_num(report[:tokens])} | #{fmt_num(report[:chars])} | #{fmt_num(report[:bytes])} |\n"
end

md << "\n## CI status\n\n"
md << "| Run | RSpec | RuboCop | Brakeman | Overall |\n"
md << "|---|---:|---:|---:|---:|\n"
md << "| Baseline | #{pass_label(status_value(baseline_status, "rspec"))} | #{pass_label(status_value(baseline_status, "rubocop"))} | #{pass_label(status_value(baseline_status, "brakeman"))} | #{pass_label(baseline_overall)} |\n"
md << "| Optimized | #{pass_label(status_value(optimized_status, "rspec"))} | #{pass_label(status_value(optimized_status, "rubocop"))} | #{pass_label(status_value(optimized_status, "brakeman"))} | #{pass_label(optimized_overall)} |\n"

tail_report = by_name.fetch("baseline_tail_logs")
summary_report = by_name.fetch("optimized_summary_only")
ratio = summary_report[:tokens].zero? ? nil : tail_report[:tokens].to_f / summary_report[:tokens].to_f

md << "\n## Interpretation\n\n"
md << "- Optimized summary is **#{ratio&.round(1) || "n/a"}x smaller** than baseline tail logs.\n"
md << "- This estimates CI/log input-token savings only, not total task savings.\n"
md << "- Actual Codex usage can differ because of hidden prompts, tool schemas, conversation history, and tool-call overhead.\n"

if by_name["baseline_important_extracts"][:tokens] > by_name["baseline_full_logs"][:tokens]
  md << "- Warning: `baseline_important_extracts` is larger than `baseline_full_logs`; extraction may duplicate too many blocks.\n"
end

md << "\n## Files\n\n"
md << "- Baseline full prompt: `#{File.join(BASELINE_DIR, "codex-prompt-full.md")}`\n"
md << "- Baseline tail prompt: `#{File.join(BASELINE_DIR, "codex-prompt-tail.md")}`\n"
md << "- Baseline important prompt: `#{File.join(BASELINE_DIR, "codex-prompt-important.md")}`\n"
md << "- Optimized summary prompt: `#{File.join(OPTIMIZED_DIR, "codex-prompt-summary.md")}`\n"
md << "- Optimized summary: `#{File.join(OPTIMIZED_DIR, "summary.md")}`\n"
md << "- JSON result: `#{File.join(BASE_DIR, "result.json")}`\n"

write(File.join(BASE_DIR, "result.md"), md)
write(".ai/experiments/latest-ci-token-savings.md", md)
write(".ai/experiments/latest-ci-token-savings.json", JSON.pretty_generate(result))

print_table(
  "SUMMARY",
  [ "Metric", "Value" ],
  [
    [ "Run ID", RUN_ID ],
    [ "Local LLM", MODEL ],
    [ "Encoding", TOKEN_ENCODING ],
    [ "Best savings", pct(best_comparison[:savings_percent]) ],
    [ "Best baseline", best_comparison[:baseline] ],
    [ "Optimized", best_comparison[:optimized] ],
    [ "Baseline CI", pass_label(baseline_overall) ],
    [ "Optimized CI", pass_label(optimized_overall) ]
  ]
)

print_table(
  "CI STATUS",
  [ "Run", "RSpec", "RuboCop", "Brakeman", "Overall" ],
  [
    [
      "baseline",
      pass_label(status_value(baseline_status, "rspec")),
      pass_label(status_value(baseline_status, "rubocop")),
      pass_label(status_value(baseline_status, "brakeman")),
      pass_label(baseline_overall)
    ],
    [
      "optimized",
      pass_label(status_value(optimized_status, "rspec")),
      pass_label(status_value(optimized_status, "rubocop")),
      pass_label(status_value(optimized_status, "brakeman")),
      pass_label(optimized_overall)
    ]
  ]
)

print_table(
  "TOKEN SCENARIOS",
  [ "Scenario", "Tokens", "Chars", "Bytes" ],
  reports
    .sort_by { |report| report[:tokens] }
    .map { |report| [ report[:name], fmt_num(report[:tokens]), fmt_num(report[:chars]), fmt_num(report[:bytes]) ] }
)

print_table(
  "SAVINGS",
  [ "Baseline", "Base tokens", "Optimized", "Opt tokens", "Savings" ],
  comparisons.map do |comparison|
    [
      comparison[:baseline],
      fmt_num(comparison[:baseline_tokens]),
      comparison[:optimized],
      fmt_num(comparison[:optimized_tokens]),
      pct(comparison[:savings_percent])
    ]
  end
)

puts
puts "INTERPRETATION"
puts "-" * 80
puts "Optimized summary is #{ratio&.round(1) || "n/a"}x smaller than baseline tail logs."
puts "This estimates CI/log input-token savings only, not total task savings."

if by_name["baseline_important_extracts"][:tokens] > by_name["baseline_full_logs"][:tokens]
  puts "Warning: baseline_important_extracts is larger than baseline_full_logs."
  puts "Extractor likely duplicated too many blocks; tune extraction before relying on it."
end

puts
puts "FILES"
puts "-" * 80
puts "Markdown report: #{File.join(BASE_DIR, "result.md")}"
puts "JSON report:     #{File.join(BASE_DIR, "result.json")}"
puts "Latest MD:       .ai/experiments/latest-ci-token-savings.md"
puts "Latest JSON:     .ai/experiments/latest-ci-token-savings.json"
