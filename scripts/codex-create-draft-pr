def json_read(path)
  JSON.parse(File.read(path))
rescue Errno::ENOENT
  abort "Missing required file: #{path}"
rescue JSON::ParserError => e
  abort "Invalid JSON in #{path}: #{e.message}"
end

def extract_json(raw)
  start = raw.index("{")
  finish = raw.rindex("}")

  raise "No JSON object found" unless start && finish && finish > start

  JSON.parse(raw[start..finish])
end

def clean_title(text)
  text.to_s.strip.gsub(/\s+/, " ")[0, 120]
end

def safe_commit_message(text, issue_number)
  msg = text.to_s.strip.gsub(/\s+/, " ")
  return "feat(ai-#{issue_number}): implement issue #{issue_number} (##{issue_number})" if msg.empty?

  unless msg.match?(/\A(feat|fix|chore|refactor|test|docs)\(ai-\d+\): /)
    msg = "feat(ai-#{issue_number}): #{msg}"
  end

  unless msg.include?("##{issue_number}")
    msg = "#{msg} (##{issue_number})"
  end

  msg[0, 180]
end

def safe_pr_title(text, issue_number)
  title = clean_title(text)
  return "feat(ai-#{issue_number}): implement issue #{issue_number}" if title.empty?

  unless title.match?(/\A(feat|fix|chore|refactor|test|docs)\(ai-\d+\): /)
    title = "feat(ai-#{issue_number}): #{title}"
  end

  title[0, 180]
end

def stageable_files
  changed = sh!("git", "diff", "--name-only").lines.map(&:strip)
  untracked = sh!("git", "ls-files", "--others", "--exclude-standard").lines.map(&:strip)

  (changed + untracked)
    .reject(&:empty?)
    .reject { |path| path.start_with?(".ai/") }
    .uniq
end

selected = json_read(".ai/selected-issue.json")
ci_status = json_read(".ai/ci-status.json")

issue_number = selected.fetch("number")
issue_title = selected.fetch("title")
expected_branch = selected.fetch("branch")

current_branch = sh!("git", "branch", "--show-current").strip

if current_branch != expected_branch
  abort <<~MSG
    Wrong branch.

    Expected: #{expected_branch}
    Current:  #{current_branch}
  MSG
end

unless ci_status.dig("overall", "passed")
  abort <<~MSG
    Local CI is not green.

    Run:

    ./scripts/codex-run-local-ci

    Then fix failures before creating PR.
  MSG
end

if read(".ai/codex-report.md").strip.empty?
  abort <<~MSG
    Missing .ai/codex-report.md.

    Codex should create this file before opening PR.
  MSG
end

if sh!("git", "status", "--short").strip.empty?
  abort "No changes to commit."
end

FileUtils.mkdir_p(".ai/pr")

write(".ai/pr/git-status.txt", sh!("git", "status", "--short"))
write(".ai/pr/diff-stat.txt", sh!("git", "diff", "--stat"))
write(".ai/pr/changed-files.txt", sh!("git", "diff", "--name-only"))
write(".ai/pr/diff.patch", sh!("git", "diff"))

diff_for_llm = read(".ai/pr/diff.patch")
if diff_for_llm.length > 80_000
  diff_for_llm = diff_for_llm[0, 80_000] + "\n\n[DIFF TRUNCATED FOR LOCAL LLM]\n"
end

prompt = <<~PROMPT
  You are a local PR preparation assistant.

  Read the provided issue, Codex report, local CI summary, changed files and diff.

  Your job:
  Generate:
  - commit message
  - PR title
  - PR body
  - short review note for the user

  Hard rules:
  - Do not invent changes.
  - Use only the provided issue, report, CI summary and diff.
  - The PR must be a draft PR.
  - The PR body must say that human review is required.
  - The PR body must include exactly this closing keyword line near the top: Closes ##{issue_number}
  - Do not omit the closing keyword.
  - Keep the commit message concise.
  - The commit message must include issue reference ##{issue_number}.
  - Prefer this commit format:
    feat(ai-#{issue_number}): short imperative message (##{issue_number})
  - If the work is clearly a bugfix, use:
    fix(ai-#{issue_number}): short imperative message (##{issue_number})
  - Do not mention files that are not in the changed files list.
  - Do not claim tests passed unless local CI summary says so.

  Return JSON only. No markdown outside JSON.

  Schema:

  {
    "commit_message": "feat(ai-#{issue_number}): short imperative message (##{issue_number})",
    "pr_title": "feat(ai-#{issue_number}): short title",
    "pr_body": "markdown body",
    "review_note": "short message for the user with what to review"
  }

  Required PR body structure:

  Closes ##{issue_number}

  ## Summary
  - ...

  ## Changes
  - ...

  ## Tests
  - ...

  ## Risk / review notes
  - ...

  ## Human review
  This PR is ready for human review. Do not merge automatically.

  ===== ISSUE =====

  #{read(".ai/issue.json")}

  ===== SELECTED ISSUE =====

  #{read(".ai/selected-issue.json")}

  ===== CODEX REPORT =====

  #{read(".ai/codex-report.md")}

  ===== LOCAL CI SUMMARY =====

  #{read(".ai/ci-summary.md")}

  ===== GIT STATUS =====

  #{read(".ai/pr/git-status.txt")}

  ===== DIFF STAT =====

  #{read(".ai/pr/diff-stat.txt")}

  ===== CHANGED FILES =====

  #{read(".ai/pr/changed-files.txt")}

  ===== DIFF =====

  #{diff_for_llm}
PROMPT

write(".ai/pr/local-pr-prompt.md", prompt)

stdout, stderr, status = Open3.capture3(
  "pi",
  "--model", MODEL,
  "--tools", "read,bash,grep,find,ls",
  "--mode", "print",
  stdin_data: prompt
)

write(".ai/pr/local-pr-generation.raw", stdout)
write(".ai/pr/local-pr-generation.stderr.log", stderr)

unless status.success?
  abort <<~MSG
    Local LLM failed while generating PR metadata.

    STDERR:
    #{stderr.lines.last(80).join}
  MSG
end

generated = extract_json(stdout)

commit_message = safe_commit_message(generated["commit_message"], issue_number)
pr_title = safe_pr_title(generated["pr_title"], issue_number)
pr_body = generated["pr_body"].to_s.strip
review_note = generated["review_note"].to_s.strip

if pr_body.empty?
  pr_body = <<~MD
    Closes ##{issue_number}

    ## Summary

    #{read(".ai/codex-report.md").strip}

    ## Tests

    #{read(".ai/ci-summary.md").strip}

    ## Human review

    This PR is ready for human review. Do not merge automatically.
  MD
end

closing_line = "Closes ##{issue_number}"

unless pr_body.match?(/(^|\n)#{Regexp.escape(closing_line)}(\n|$)/)
  pr_body = "#{closing_line}\n\n#{pr_body}"
end

write(".ai/pr/commit-message.txt", "#{commit_message}\n")
write(".ai/pr/pr-title.txt", "#{pr_title}\n")
write(".ai/pr/pr-body.md", pr_body)
write(".ai/pr/review-note.md", review_note)

files_to_stage = stageable_files

if files_to_stage.empty?
  abort "No stageable files after excluding .ai/."
end

puts "Preparing draft PR for issue ##{issue_number}"
puts "Branch: #{current_branch}"
puts
puts "Files to stage:"
files_to_stage.each { |path| puts "- #{path}" }
puts
puts "Generated commit message:"
puts commit_message
puts
puts "Generated PR title:"
puts pr_title
puts

files_to_stage.each do |path|
  sh!("git", "add", "--", path)
end

if sh!("git", "diff", "--cached", "--name-only").strip.empty?
  abort "Nothing staged."
end

sh!("git", "commit", "-m", commit_message)

sh!("git", "push", "-u", "origin", current_branch)

existing_pr_stdout, _existing_pr_stderr, existing_pr_status = Open3.capture3(
  "gh",
  "pr",
  "view",
  current_branch,
  "--json",
  "url",
  "--jq",
  ".url"
)

if existing_pr_status.success? && !existing_pr_stdout.strip.empty?
  pr_url = existing_pr_stdout.strip
else
