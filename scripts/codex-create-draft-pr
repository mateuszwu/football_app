#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "fileutils"
require "open3"

MAIN_BRANCH = ENV.fetch("MAIN_BRANCH", "main")

def require_tool!(name)
  system("command -v #{name} >/dev/null 2>&1") || abort("Missing required tool: #{name}")
end

%w[git gh ruby].each { |tool| require_tool!(tool) }

def write(path, content)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, content)
end

def read(path)
  File.exist?(path) ? File.read(path) : ""
end

def sh!(*args)
  stdout, stderr, status = Open3.capture3(*args)

  unless status.success?
    abort <<~MSG
      Command failed:
      #{args.join(" ")}

      STDERR:
      #{stderr}
    MSG
  end

  stdout
end

def sh(*args)
  stdout, stderr, status = Open3.capture3(*args)

  {
    stdout: stdout,
    stderr: stderr,
    success: status.success?,
    exit_code: status.exitstatus
  }
end

def json_read(path)
  JSON.parse(File.read(path))
rescue Errno::ENOENT
  abort "Missing required file: #{path}"
rescue JSON::ParserError => e
  abort "Invalid JSON in #{path}: #{e.message}"
end

def clean_title(text)
  text.to_s.strip.gsub(/\s+/, " ")[0, 120]
end

def safe_commit_message(text, issue_number)
  msg = text.to_s.strip.gsub(/\s+/, " ")
  return "feat(ai-#{issue_number}): implement issue #{issue_number} (##{issue_number})" if msg.empty?

  unless msg.match?(/\A(feat|fix|chore|refactor|test|docs)\(ai-\d+\): /)
    msg = "feat(ai-#{issue_number}): #{msg}"
  end

  unless msg.include?("##{issue_number}")
    msg = "#{msg} (##{issue_number})"
  end

  msg[0, 180]
end

def safe_pr_title(text, issue_number)
  title = clean_title(text)
  return "feat(ai-#{issue_number}): implement issue #{issue_number}" if title.empty?

  unless title.match?(/\A(feat|fix|chore|refactor|test|docs)\(ai-\d+\): /)
    title = "feat(ai-#{issue_number}): #{title}"
  end

  title[0, 180]
end

def stageable_files
  changed = sh!("git", "diff", "--name-only").lines.map(&:strip)
  untracked = sh!("git", "ls-files", "--others", "--exclude-standard").lines.map(&:strip)

  (changed + untracked)
    .reject(&:empty?)
    .reject { |path| path.start_with?(".ai/") }
    .uniq
end

def compact_markdown(text, max_length)
  text.to_s.strip.gsub(/\n{3,}/, "\n\n")[0, max_length]
end

def deterministic_pr_body(issue_number, issue_title, report, ci_summary, changed_files)
  summary = compact_markdown(report, 2_000)
  tests = compact_markdown(ci_summary, 1_500)
  change_list = changed_files.first(10).map { |path| "- `#{path}`" }.join("\n")

  <<~MD
    Closes ##{issue_number}

    ## Summary
    - Implements: #{issue_title}
    - See Codex report for implementation details

    ## Changes
    #{change_list.empty? ? "- See committed diff" : change_list}

    ## Tests
    #{tests.empty? ? "- See local CI artifacts" : tests}

    ## Risk / review notes
    #{summary.empty? ? "- Review the changed files and local CI artifacts." : summary}

    ## Human review
    This PR is ready for human review. Do not merge automatically.
  MD
end

def deterministic_review_note(changed_files)
  return "Review the implementation scope and local CI results." if changed_files.empty?

  "Review the changed files: #{changed_files.first(6).join(', ')}#{changed_files.size > 6 ? ', ...' : ''}."
end

selected = json_read(".ai/selected-issue.json")
ci_status = json_read(".ai/ci-status.json")

issue_number = selected.fetch("number")
issue_title = selected.fetch("title")
expected_branch = selected.fetch("branch")

current_branch = sh!("git", "branch", "--show-current").strip

if current_branch != expected_branch
  abort <<~MSG
    Wrong branch.

    Expected: #{expected_branch}
    Current:  #{current_branch}
  MSG
end

unless ci_status.dig("overall", "passed")
  abort <<~MSG
    Local CI is not green.

    Run:

    ./scripts/codex-run-local-ci

    Then fix failures before creating PR.
  MSG
end

if read(".ai/codex-report.md").strip.empty?
  abort <<~MSG
    Missing .ai/codex-report.md.

    Codex should create this file before opening PR.
  MSG
end

if sh!("git", "status", "--short").strip.empty?
  abort "No changes to commit."
end

FileUtils.mkdir_p(".ai/pr")

write(".ai/pr/git-status.txt", sh!("git", "status", "--short"))
write(".ai/pr/diff-stat.txt", sh!("git", "diff", "--stat"))
write(".ai/pr/changed-files.txt", sh!("git", "diff", "--name-only"))
changed_files = read(".ai/pr/changed-files.txt").lines.map(&:strip).reject(&:empty?)
report = read(".ai/codex-report.md")
ci_summary = read(".ai/ci-summary.md")

commit_message = safe_commit_message(issue_title.downcase, issue_number)
pr_title = safe_pr_title(issue_title, issue_number)
pr_body = deterministic_pr_body(issue_number, issue_title, report, ci_summary, changed_files)
review_note = deterministic_review_note(changed_files)

closing_line = "Closes ##{issue_number}"

unless pr_body.match?(/(^|\n)#{Regexp.escape(closing_line)}(\n|$)/)
  pr_body = "#{closing_line}\n\n#{pr_body}"
end

write(".ai/pr/commit-message.txt", "#{commit_message}\n")
write(".ai/pr/pr-title.txt", "#{pr_title}\n")
write(".ai/pr/pr-body.md", pr_body)
write(".ai/pr/review-note.md", review_note)

files_to_stage = stageable_files

if files_to_stage.empty?
  abort "No stageable files after excluding .ai/."
end

puts "Preparing draft PR for issue ##{issue_number}"
puts "Branch: #{current_branch}"
puts
puts "Files to stage:"
files_to_stage.each { |path| puts "- #{path}" }
puts
puts "Generated commit message:"
puts commit_message
puts
puts "Generated PR title:"
puts pr_title
puts

files_to_stage.each do |path|
  sh!("git", "add", "--", path)
end

if sh!("git", "diff", "--cached", "--name-only").strip.empty?
  abort "Nothing staged."
end

sh!("git", "commit", "-m", commit_message)

sh!("git", "push", "-u", "origin", current_branch)

existing_pr_stdout, _existing_pr_stderr, existing_pr_status = Open3.capture3(
  "gh",
  "pr",
  "view",
  current_branch,
  "--json",
  "url",
  "--jq",
  ".url"
)

if existing_pr_status.success? && !existing_pr_stdout.strip.empty?
  pr_url = existing_pr_stdout.strip
else
  create_result = sh(
    "gh",
    "pr",
    "create",
    "--draft",
    "--base",
    MAIN_BRANCH,
    "--head",
    current_branch,
    "--title",
    pr_title,
    "--body-file",
    ".ai/pr/pr-body.md"
  )

  unless create_result[:success]
    abort <<~MSG
      Command failed:
      gh pr create --draft --base #{MAIN_BRANCH} --head #{current_branch} --title #{pr_title} --body-file .ai/pr/pr-body.md

      STDERR:
      #{create_result[:stderr]}
    MSG
  end

  pr_url = create_result[:stdout].lines.map(&:strip).find { |line| line.match?(%r{\Ahttps://github\.com/}) }.to_s
  pr_url = sh!("gh", "pr", "view", current_branch, "--json", "url", "--jq", ".url").strip if pr_url.empty?
end

write(".ai/pr-url.txt", "#{pr_url}\n")

puts
puts "Draft PR created:"
puts pr_url
puts

unless review_note.empty?
  puts "Review note:"
  puts review_note
  puts
end

puts "Send this link to the user for human review."
