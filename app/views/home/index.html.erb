<% content_for :title, "Football App" %>

<section class="hero" id="dashboard">
  <div class="hero__content">
    <p class="eyebrow">Weekendowe granie</p>
    <h1>Football App</h1>
    <p class="hero__lead">
      Publiczny dashboard dla amatorskiej piłki: obecne mecze, leaderboardy i profile zawodników w jednym miejscu.
    </p>
  </div>
</section>

<section class="section">
  <div class="section__header">
    <h2>Dashboard</h2>
    <p>Tu pojawi się aktualny dzień grania, status meczów i szybkie podsumowanie sezonu.</p>
  </div>

  <div class="summary-grid">
    <article class="summary-card">
      <span class="summary-card__label">Najbliższy match day</span>
      <strong>Do ustawienia</strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label">Aktywny sezon</span>
      <strong>Brak danych</strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label">Zawodnicy</span>
      <strong>Lista w przygotowaniu</strong>
    </article>
  </div>
</section>

<section class="section section--muted" id="leaderboards">
  <div class="section__header">
    <h2>Leaderboardy</h2>
    <p>Rankingi Elo, gole, asysty oraz głosy MVP/DEF będą publiczne po dodaniu danych sezonu.</p>
  </div>
</section>

<section class="section" id="players">
  <div class="section__header">
    <h2>Zawodnicy</h2>
    <p>Publiczna lista profili i formularz dodania zawodnika pojawią się w kolejnych zadaniach MVP 1.</p>
  </div>
</section>
