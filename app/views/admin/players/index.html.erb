<% content_for :title, t("admin.players_title") %>

<section class="section" id="admin-players">
  <div class="section__header">
    <span class="section__eyebrow">Admin</span>
    <h1><%= t("players.title") %></h1>
    <p><%= t("admin.players_intro") %></p>
  </div>

  <% if players.any? %>
    <div class="table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col"><%= t("players.short_name") %></th>
            <th scope="col"><%= t("players.nickname") %></th>
            <th scope="col"><%= t("players.phone") %></th>
            <th scope="col"><%= t("players.role") %></th>
            <th scope="col"><%= t("players.status") %></th>
            <th scope="col"><%= t("players.active") %></th>
            <th scope="col"><%= t("admin.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% players.each do |player| %>
            <tr>
              <td><%= player.name %></td>
              <td><%= player.nickname %></td>
              <td><%= player.phone %></td>
              <td><%= role_label(player.role_code) %></td>
              <td><%= status_label(player.approval_status) %></td>
              <td><%= yes_no_label(player.active?) %></td>
              <td class="admin-table__actions">
                <%= link_to t("admin.edit"), edit_admin_player_path(player) %>
                <%= button_to t("admin.approve"), approve_admin_player_path(player), method: :patch, class: "link-button" %>
                <%= button_to t("admin.reject"), reject_admin_player_path(player), method: :patch, class: "link-button" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p><%= t("admin.no_players") %></p>
  <% end %>
</section>
