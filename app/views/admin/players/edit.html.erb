<% content_for :title, "Edit Player" %>

<section class="section" id="admin-player-edit">
  <div class="section__header">
    <span class="section__eyebrow">Admin</span>
    <h1>Edytuj zawodnika</h1>
    <p>Aktualizuj dane zawodnika widoczne w panelu administracyjnym.</p>
  </div>

  <% if player.errors.any? %>
    <div class="form-errors">
      <p>Popraw bledy formularza:</p>
      <ul>
        <% player.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [:admin, player], class: "admin-form" do |form| %>
    <div class="form-field">
      <%= form.label :name, "Imie" %>
      <%= form.text_field :name, required: true %>
    </div>

    <div class="form-field">
      <%= form.label :nickname, "Nick" %>
      <%= form.text_field :nickname, required: true %>
    </div>

    <div class="form-field">
      <%= form.label :phone, "Telefon" %>
      <%= form.telephone_field :phone, required: true %>
    </div>

    <div class="form-field">
      <%= form.label :description, "Opis" %>
      <%= form.text_area :description, required: true, rows: 4 %>
    </div>

    <div class="form-field">
      <%= form.label :role_code, "Rola" %>
      <%= form.select :role_code, Player::ROLE_CODES %>
    </div>

    <div class="form-field">
      <%= form.label :approval_status, "Status" %>
      <%= form.select :approval_status, Player::APPROVAL_STATUSES %>
    </div>

    <div class="form-checkbox">
      <%= form.check_box :active %>
      <%= form.label :active, "Aktywny" %>
    </div>

    <div class="form-actions">
      <%= form.submit "Zapisz", class: "button button--primary" %>
      <%= link_to "Wroc", admin_players_path, class: "button button--secondary" %>
    </div>
  <% end %>
</section>
