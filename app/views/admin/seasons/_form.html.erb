<% if season.errors.any? %>
  <div class="form-errors">
    <p>Popraw bledy formularza:</p>
    <ul>
      <% season.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, season], class: "admin-form" do |form| %>
  <div class="form-field">
    <%= form.label :name, "Nazwa" %>
    <%= form.text_field :name, required: true %>
  </div>

  <div class="form-field">
    <%= form.label :starts_on, "Start" %>
    <%= form.date_field :starts_on, required: true %>
  </div>

  <div class="form-field">
    <%= form.label :ends_on, "Koniec" %>
    <%= form.date_field :ends_on %>
  </div>

  <div class="form-checkbox">
    <%= form.check_box :active %>
    <%= form.label :active, "Aktywny" %>
  </div>

  <div class="form-field">
    <%= form.label :initial_elo, "Initial Elo" %>
    <%= form.number_field :initial_elo, min: 1, required: true %>
  </div>

  <div class="form-field">
    <%= form.label :elo_k_factor, "K-factor" %>
    <%= form.number_field :elo_k_factor, min: 1, required: true %>
  </div>

  <div class="form-field">
    <%= form.label :mvp_vote_bonus, "MVP bonus" %>
    <%= form.number_field :mvp_vote_bonus, min: 0, required: true %>
  </div>

  <div class="form-field">
    <%= form.label :def_vote_bonus, "DEF bonus" %>
    <%= form.number_field :def_vote_bonus, min: 0, required: true %>
  </div>

  <div class="form-actions">
    <%= form.submit "Zapisz", class: "button button--primary" %>
    <%= link_to "Wroc", admin_seasons_path, class: "button button--secondary" %>
  </div>
<% end %>
