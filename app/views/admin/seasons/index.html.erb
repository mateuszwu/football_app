<% content_for :title, t("seasons.admin_title") %>

<section class="section" id="admin-seasons">
  <div class="section__header">
    <span class="section__eyebrow">Admin</span>
    <h1><%= t("seasons.title") %></h1>
    <p><%= t("seasons.admin_intro") %></p>
  </div>

  <p><%= link_to t("seasons.new"), new_admin_season_path, class: "button button--secondary" %></p>

  <% if seasons.any? %>
    <div class="table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col"><%= t("seasons.name") %></th>
            <th scope="col"><%= t("seasons.start") %></th>
            <th scope="col"><%= t("seasons.end") %></th>
            <th scope="col"><%= t("seasons.status") %></th>
            <th scope="col"><%= t("seasons.initial_elo") %></th>
            <th scope="col"><%= t("seasons.k_factor") %></th>
            <th scope="col"><%= t("seasons.elo_k_value") %></th>
            <th scope="col"><%= t("seasons.advantage_elo") %></th>
            <th scope="col"><%= t("seasons.mvp_bonus") %></th>
            <th scope="col"><%= t("seasons.def_bonus") %></th>
            <th scope="col"><%= t("seasons.goal_points") %></th>
            <th scope="col"><%= t("seasons.assist_points") %></th>
            <th scope="col"><%= t("admin.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% seasons.each do |season| %>
            <tr>
              <td><%= season.name %></td>
              <td><%= season.starts_on %></td>
              <td><%= season.ends_on || t("common.none") %></td>
              <td><%= status_label(season.status) %></td>
              <td><%= season.initial_elo %></td>
              <td><%= season.elo_k_factor %></td>
              <td><%= season.elo_k_value %></td>
              <td><%= season.player_advantage_elo %></td>
              <td><%= season.mvp_vote_bonus %></td>
              <td><%= season.def_vote_bonus %></td>
              <td><%= season.goal_points %></td>
              <td><%= season.assist_points %></td>
              <td class="admin-table__actions">
                <%= link_to t("admin.edit"), edit_admin_season_path(season) %>
                <%= button_to t("admin.delete"), admin_season_path(season), method: :delete, class: "link-button" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p><%= t("seasons.no_seasons") %></p>
  <% end %>
</section>
