<% content_for :title, "Admin Seasons" %>

<section class="section" id="admin-seasons">
  <div class="section__header">
    <span class="section__eyebrow">Admin</span>
    <h1>Sezony</h1>
    <p>Konfiguracja sezonow, Elo i bonusow za glosy MVP/DEF.</p>
  </div>

  <p><%= link_to "Nowy sezon", new_admin_season_path, class: "button button--secondary" %></p>

  <% if seasons.any? %>
    <div class="table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Nazwa</th>
            <th scope="col">Start</th>
            <th scope="col">Koniec</th>
            <th scope="col">Aktywny</th>
            <th scope="col">Initial Elo</th>
            <th scope="col">K-factor</th>
            <th scope="col">MVP bonus</th>
            <th scope="col">DEF bonus</th>
            <th scope="col">Akcje</th>
          </tr>
        </thead>
        <tbody>
          <% seasons.each do |season| %>
            <tr>
              <td><%= season.name %></td>
              <td><%= season.starts_on %></td>
              <td><%= season.ends_on || "Brak" %></td>
              <td><%= season.active? ? "Tak" : "Nie" %></td>
              <td><%= season.initial_elo %></td>
              <td><%= season.elo_k_factor %></td>
              <td><%= season.mvp_vote_bonus %></td>
              <td><%= season.def_vote_bonus %></td>
              <td class="admin-table__actions">
                <%= link_to "Edytuj", edit_admin_season_path(season) %>
                <%= button_to "Usun", admin_season_path(season), method: :delete, class: "link-button" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>Brak sezonow do wyswietlenia.</p>
  <% end %>
</section>
