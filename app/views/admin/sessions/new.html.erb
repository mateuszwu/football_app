<% content_for :title, "Admin Login" %>

<section class="section" id="admin-login">
  <div class="section__header">
    <span class="section__eyebrow">Admin</span>
    <h1>Zaloguj</h1>
    <p>Podaj haslo administratora, aby przejsc do panelu zarzadzania.</p>
  </div>

  <%= form_with url: admin_session_path, method: :post, class: "admin-login-form" do |form| %>
    <div class="form-field">
      <%= form.label :password, "Haslo" %>
      <%= form.password_field :password, autocomplete: "current-password", required: true %>
    </div>

    <%= form.submit "Zaloguj", class: "button button--primary" %>
  <% end %>
</section>
