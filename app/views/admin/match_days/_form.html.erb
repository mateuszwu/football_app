<% if match_day.errors.any? %>
  <div class="form-errors">
    <p>Popraw bledy formularza:</p>
    <ul>
      <% match_day.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, match_day], class: "admin-form" do |form| %>
  <div class="form-field">
    <%= form.label :season_id, "Sezon" %>
    <%= form.collection_select :season_id, seasons, :id, :name, { prompt: "Wybierz sezon" }, required: true %>
  </div>

  <div class="form-field">
    <%= form.label :played_on, "Data grania" %>
    <%= form.date_field :played_on, required: true %>
  </div>

  <div class="form-field">
    <label>Status</label>
    <p class="status-badge"><%= match_day.status.presence || "setup" %></p>
  </div>

  <div class="form-field">
    <label>Obecni zawodnicy</label>
    <% if players.any? %>
      <div class="checkbox-list">
        <% players.each do |player| %>
          <label class="checkbox-list__item">
            <%= check_box_tag "match_day[player_ids][]", player.id, match_day.player_ids.include?(player.id) %>
            <span><%= player.name %> (<%= player.nickname %>)</span>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">Brak aktywnych i zatwierdzonych zawodnikow.</p>
    <% end %>
  </div>

  <div class="form-field">
    <label>Manualny builder bazowych zespolow</label>
    <p class="field-hint">Przeciagnij zaznaczonych zawodnikow do Team A albo Team B.</p>

    <% if players.any? %>
      <div
        class="lineup-editor"
        data-controller="lineup-editor"
        data-lineup-editor-team-a-player-ids-value="<%= team_a_player_ids.to_json %>"
        data-lineup-editor-team-b-player-ids-value="<%= team_b_player_ids.to_json %>"
        data-lineup-editor-team-waiting-player-ids-value="<%= team_waiting_player_ids.to_json %>"
      >
        <div class="lineup-editor__columns">
          <section class="lineup-column" data-lineup-column="pool">
            <header class="lineup-column__header">
              <h3>Dostepni</h3>
              <p>Zaznaczeni zawodnicy gotowi do przypisania.</p>
            </header>
            <div class="lineup-column__list" data-lineup-list="pool" data-lineup-editor-target="pool"></div>
          </section>

          <section class="lineup-column" data-lineup-column="team_a">
            <header class="lineup-column__header">
              <h3>Team A</h3>
              <p>Przeciagnij tutaj sklad Team A.</p>
            </header>
            <div class="lineup-column__list" data-lineup-list="team_a" data-lineup-editor-target="teamA"></div>
            <div data-lineup-inputs="team_a" data-lineup-editor-target="teamAInputs"></div>
          </section>

          <section class="lineup-column" data-lineup-column="team_b">
            <header class="lineup-column__header">
              <h3>Team B</h3>
              <p>Przeciagnij tutaj sklad Team B.</p>
            </header>
            <div class="lineup-column__list" data-lineup-list="team_b" data-lineup-editor-target="teamB"></div>
            <div data-lineup-inputs="team_b" data-lineup-editor-target="teamBInputs"></div>
          </section>

          <section class="lineup-column" data-lineup-column="team_waiting">
            <header class="lineup-column__header">
              <h3>Team 3 (Czeka)</h3>
              <p>Zawodnicy oczekujacy (opcjonalne).</p>
            </header>
            <div class="lineup-column__list" data-lineup-list="team_waiting" data-lineup-editor-target="teamWaiting"></div>
            <div data-lineup-inputs="team_waiting" data-lineup-editor-target="teamWaitingInputs"></div>
          </section>
        </div>
      </div>
    <% else %>
      <p class="empty-state">Brak zawodnikow do przypisania.</p>
    <% end %>
  </div>

  <div class="form-actions">
    <%= form.submit "Zapisz", class: "button button--primary" %>
    <%= link_to "Wroc", admin_match_days_path, class: "button button--secondary" %>
  </div>
<% end %>
