<% if match_day.errors.any? %>
  <div class="form-errors">
    <p>Popraw bledy formularza:</p>
    <ul>
      <% match_day.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, match_day], class: "admin-form" do |form| %>
  <%= hidden_field_tag "match_day[setup_method]", setup_method %>
  <%= hidden_field_tag "match_day[algorithm_version]", algorithm_version %>
  <%= hidden_field_tag "match_day[reroll_count]", reroll_count %>

  <div class="form-field">
    <%= form.label :season_id, "Sezon" %>
    <%= form.collection_select :season_id, seasons, :id, :name, { prompt: "Wybierz sezon" }, required: true %>
  </div>

  <div class="form-field">
    <%= form.label :played_on, "Data grania" %>
    <%= form.date_field :played_on, required: true %>
  </div>

  <div class="form-field">
    <label>Status</label>
    <p class="status-badge"><%= match_day.status.presence || "setup" %></p>
  </div>

  <div class="form-field">
    <label>Obecni zawodnicy</label>
    <% if players.any? %>
      <div class="checkbox-list">
        <% players.each do |player| %>
          <label class="checkbox-list__item">
            <%= check_box_tag "match_day[player_ids][]", player.id, selected_player_ids.include?(player.id) %>
            <span><%= player.name %> (<%= player.nickname %>)</span>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">Brak aktywnych i zatwierdzonych zawodnikow.</p>
    <% end %>
  </div>

  <div class="form-field">
    <div class="field-header">
      <label>Manualny builder bazowych zespolow</label>
      <div class="form-actions">
        <button type="submit" name="preview_auto_proposal" value="1" class="button button--small button--secondary">
          Generuj auto
        </button>
        <% if setup_method == TeamSetup::SETUP_METHOD_AUTO %>
          <button type="submit" name="reroll_auto_proposal" value="1" class="button button--small button--secondary">
            Przelosuj
          </button>
        <% end %>
        <button type="button" class="button button--small button--secondary" data-action="lineup-editor#addTeam">
          Dodaj zespol
        </button>
      </div>
    </div>
    <p class="field-hint">
      Przeciagnij zaznaczonych zawodnikow do zespolow.
      <% if setup_method == TeamSetup::SETUP_METHOD_AUTO %>
        Auto proposal <%= algorithm_version.presence || Teams::GenerateProposal::ALGORITHM_VERSION %>, rerolle: <%= reroll_count %>.
      <% end %>
    </p>

    <% if players.any? %>
      <div
        class="lineup-editor"
        data-controller="lineup-editor"
        data-lineup-editor-teams-value="<%= teams_data.to_json %>"
      >
        <div class="lineup-editor__columns">
          <section class="lineup-column" data-lineup-column="pool">
            <header class="lineup-column__header">
              <h3>Dostepni</h3>
              <p>Zaznaczeni zawodnicy gotowi do przypisania.</p>
            </header>
            <div class="lineup-column__list" data-lineup-list="pool" data-lineup-editor-target="pool"></div>
          </section>

          <div class="lineup-editor__dynamic-columns" data-lineup-editor-target="columnsContainer">
            <%# Rendered by Stimulus %>
          </div>
        </div>
      </div>
    <% else %>
      <p class="empty-state">Brak zawodnikow do przypisania.</p>
    <% end %>
  </div>

  <div class="form-actions">
    <%= form.submit "Zapisz", class: "button button--primary" %>
    <%= link_to "Wroc", admin_match_days_path, class: "button button--secondary" %>
  </div>
<% end %>
