<% content_for :title, "New Match Day" %>

<section class="section" id="admin-match-day-new">
  <div class="section__header">
    <span class="section__eyebrow">Admin</span>
    <h1>Nowy match day</h1>
    <p>Ustaw sezon i termin grania przed wyborem obecnych zawodnikow.</p>
  </div>

  <%= render "form",
      match_day: match_day,
      seasons: seasons,
      players: players,
      teams_data: teams_data,
      selected_player_ids: selected_player_ids,
      setup_method: setup_method,
      algorithm_version: algorithm_version,
      reroll_count: reroll_count %>
</section>
