<% content_for :title, "#{t("relationships.graph_title")} - #{t("app.name")}" %>
<% graph_layout = relationship_graph_layout(players: players, edges: edges) %>

<section class="section">
  <div class="section__header">
    <p class="eyebrow"><%= t("relationships.title") %></p>
    <h1><%= t("relationships.graph_title") %></h1>
    <p><%= t("relationships.graph_intro") %></p>
  </div>

  <div class="summary-grid">
    <article class="summary-card">
      <span class="summary-card__label"><%= t("relationships.public_players") %></span>
      <strong><%= players.count %></strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label"><%= t("relationships.visible_connections") %></span>
      <strong><%= edges.count %></strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label"><%= t("relationships.strongest_duo") %></span>
      <% if strongest_edge %>
        <strong><%= strongest_edge.player_one.name %> + <%= strongest_edge.player_two.name %></strong>
        <span><%= t("dashboard.labels.shared_play_days", count: strongest_edge.shared_match_days_count) %></span>
      <% else %>
        <strong><%= t("common.none") %></strong>
      <% end %>
    </article>
  </div>
</section>

<section class="section">
  <div class="section__header">
    <h2><%= t("relationships.visual_network") %></h2>
    <p><%= t("relationships.visual_network_intro") %></p>
  </div>

  <% if graph_layout.nodes.any? %>
    <div class="relationship-graph-shell">
      <svg
        aria-labelledby="relationship-graph-title"
        class="relationship-graph"
        role="img"
        viewBox="0 0 <%= graph_layout.width %> <%= graph_layout.height %>"
      >
        <title id="relationship-graph-title"><%= t("relationships.graph_accessible_title") %></title>

        <% graph_layout.edges.each do |edge| %>
          <line
            class="relationship-graph__edge"
            x1="<%= edge.x1 %>"
            y1="<%= edge.y1 %>"
            x2="<%= edge.x2 %>"
            y2="<%= edge.y2 %>"
            stroke-width="<%= edge.stroke_width %>"
          >
            <title><%= "#{edge.player_one.name} i #{edge.player_two.name}: #{t("dashboard.labels.shared_play_days", count: edge.shared_match_days_count)}" %></title>
          </line>
        <% end %>

        <% graph_layout.nodes.each do |node| %>
          <a href="<%= player_path(node.player) %>">
            <circle
              class="relationship-graph__node"
              cx="<%= node.x %>"
              cy="<%= node.y %>"
              r="16"
            >
              <title><%= "#{node.player.name} (#{node.player.nickname})" %></title>
            </circle>
            <text
              class="relationship-graph__label"
              text-anchor="middle"
              x="<%= node.label_x %>"
              y="<%= node.label_y %>"
            ><%= node.player.name %></text>
          </a>
        <% end %>
      </svg>
    </div>
  <% else %>
    <p class="empty-state"><%= t("relationships.no_graph_players") %></p>
  <% end %>
</section>

<section class="section section--muted">
  <div class="section__header">
    <h2><%= t("relationships.strongest_connections") %></h2>
    <p><%= t("relationships.strongest_connections_intro") %></p>
  </div>

  <% if edges.any? %>
    <ol class="relationship-list">
      <% edges.each do |edge| %>
        <li class="relationship-list__item">
          <div>
            <strong><%= link_to edge.player_one.name, player_path(edge.player_one) %></strong>
            <span class="relationship-list__connector">&harr;</span>
            <strong><%= link_to edge.player_two.name, player_path(edge.player_two) %></strong>
          </div>
          <span class="status-badge"><%= t("dashboard.labels.shared_play_days", count: edge.shared_match_days_count) %></span>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="empty-state"><%= t("relationships.no_connections") %></p>
  <% end %>
</section>

<section class="section">
  <div class="section__header">
    <h2><%= t("relationships.best_teammates") %></h2>
    <p><%= t("relationships.best_teammates_intro") %></p>
  </div>

  <% if nodes.any? %>
    <div class="player-grid">
      <% nodes.each do |node| %>
        <article class="player-card">
          <h3><%= link_to node.player.name, player_path(node.player) %></h3>
          <p class="player-card__meta"><%= node.player.nickname %> &middot; <%= role_label(node.player.role_code) %></p>

          <% if node.top_teammates.any? %>
            <p><%= t("relationships.best_connection") %></p>
            <ul class="relationship-node-list">
              <% node.top_teammates.each do |teammate| %>
                <li><%= link_to teammate.name, player_path(teammate) %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="empty-state"><%= t("relationships.no_teammates") %></p>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="empty-state"><%= t("relationships.no_players_for_graph") %></p>
  <% end %>
</section>
