<% content_for :title, "#{t("relationships.title")} - #{t("app.name")}" %>
<section class="relationships-page">
  <header class="relationships-hero">
    <h1><%= t("relationships.title") %></h1>
    <p><%= t("relationships.graph_intro") %></p>
  </header>

  <div class="relationships-summary">
    <% relationship_summary_cards(duo_insights).each do |card| %>
      <% summary = card.fetch(:summary) %>
      <% tooltip_id = "relationship-summary-tooltip-#{card.fetch(:key)}" %>
      <article class="synergy-summary-card">
        <%= render "shared/decorative_card_icon", icon: card.fetch(:icon), fallback: card.fetch(:fallback), class_name: "synergy-summary-card__watermark" %>
        <div class="synergy-summary-card__content decorative-card-content">
          <span class="synergy-summary-card__label-row">
            <span class="synergy-summary-card__tooltip-anchor">
              <button type="button" class="synergy-summary-card__tooltip-control" aria-label="<%= t("relationships.summary_tooltips.label", title: t("relationships.summary.#{card.fetch(:key)}")) %>" aria-describedby="<%= tooltip_id %>">
                <%= safe_lucide_icon("info", fallback: "circle-help", class_name: "synergy-summary-card__tooltip-icon") %>
              </button>
              <span class="synergy-summary-card__tooltip" id="<%= tooltip_id %>" role="tooltip"><%= t("relationships.summary_tooltips.#{card.fetch(:tooltip_key)}") %></span>
            </span>
            <span class="synergy-summary-card__label"><%= t("relationships.summary.#{card.fetch(:key)}") %></span>
          </span>
          <% if summary.present? && !summary.empty? %>
            <div class="relationship-summary-player-group">
              <%= render "shared/player_identity_pill", player: summary.player_a, size: :xs, variant: :compact %>
              <span class="relationship-summary-player-plus" aria-hidden="true">+</span>
              <%= render "shared/player_identity_pill", player: summary.player_b, size: :xs, variant: :compact %>
            </div>
            <em class="synergy-summary-card__metric"><%= relationship_primary_metric(summary, card.fetch(:primary_metric)) %></em>
            <div class="synergy-summary-card__chips">
              <% relationship_secondary_metrics(summary, card.fetch(:primary_metric)).each do |metric| %>
                <span class="synergy-summary-card__chip"><%= metric %></span>
              <% end %>
            </div>
          <% else %>
            <div class="synergy-summary-card__avatars synergy-summary-card__avatars--empty" aria-hidden="true">
              <span class="synergy-summary-card__avatar synergy-summary-card__avatar--empty">?</span>
              <span class="synergy-summary-card__avatar synergy-summary-card__avatar--empty">?</span>
            </div>
            <strong class="synergy-summary-card__names synergy-summary-card__names--empty"><%= t("relationships.empty.summary_card") %></strong>
            <p class="synergy-summary-card__empty-body"><%= t("relationships.empty.summary_card_body") %></p>
            <div class="synergy-summary-card__chips">
              <span class="synergy-summary-card__chip synergy-summary-card__chip--muted"><%= t("relationships.empty.not_enough_data") %></span>
            </div>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>

  <%= turbo_frame_tag "relationships_results", target: "_top", data: { controller: "preserve-scroll" } do %>
    <div class="relationships-tabs-row">
      <nav class="leaderboards-tabs relationships-tabs" aria-label="<%= t("relationships.title") %>">
        <% relationship_tabs(active_tab).each do |tab| %>
          <%= link_to relationships_path(tab: tab.fetch(:key), direction:, limit:, metric:, season_id: season&.id, minimum_shared_matches: tab.fetch(:active) ? minimum_shared_matches : tab_minimums.fetch(tab.fetch(:key)), player_filter:, player_id:), class: "leaderboards-tab #{'leaderboards-tab--active' if tab.fetch(:active)}", aria: ({ current: "page" } if tab.fetch(:active)) do %>
            <span><%= tab.fetch(:label) %></span>
          <% end %>
        <% end %>
      </nav>

      <div class="relationships-tabs-meta" aria-label="<%= t("relationships.stats_label") %>">
        <% if active_tab == "graph" %>
          <span><%= t("relationships.labels.players_count", count: graph_data.dig(:meta, :players_count)) %></span>
          <span><%= t("relationships.labels.connections_count", count: graph_data.dig(:meta, :edges_count)) %></span>
        <% else %>
          <span><%= t("relationships.labels.players_count", count: relationship_ranking_players_count(combination_ranking)) %></span>
          <span><%= t("relationships.labels.connections_count", count: combination_ranking.count) %></span>
        <% end %>
      </div>
    </div>

    <% if active_tab == "graph" %>
      <div class="synergy-graph-layout">
        <section class="synergy-graph-card">
          <div class="synergy-graph-card__header">
            <h2><%= t("relationships.graph.title") %></h2>
            <p><%= t("relationships.graph.subtitle") %></p>
          </div>

          <% if graph_data.fetch(:meta).fetch(:edges_count).positive? %>
            <div
              data-controller="synergy-graph"
              data-synergy-graph-data-value="<%= json_escape(graph_data.to_json) %>"
              class="synergy-graph-network"
            ></div>
          <% else %>
            <div class="synergy-graph-empty">
              <h3><%= t("relationships.graph.no_data_title") %></h3>
              <p><%= t("relationships.graph.no_data_body") %></p>
            </div>
          <% end %>
        </section>

        <aside class="synergy-graph-side-panel">
          <%= form_with url: relationships_path, method: :get, local: true, class: "synergy-graph-controls", data: { turbo_frame: "relationships_results" } do |form| %>
            <%= form.hidden_field :tab, value: "graph" %>
            <%= form.hidden_field :season_id, value: season&.id if season.present? %>
            <%= form.hidden_field :player_id, value: player_id if player_id.present? %>

            <h2><%= t("relationships.graph.controls_title") %></h2>

            <div class="relationships-control">
              <%= form.label :minimum_shared_matches, t("relationships.graph.minimum_shared_matches") %>
              <%= form.number_field :minimum_shared_matches, value: minimum_shared_matches, min: 1, step: 1 %>
            </div>

            <div class="relationships-control">
              <%= form.label :limit, t("relationships.graph.limit") %>
              <%= form.select :limit, [ 20, 50, 100 ].map { |value| [ value, value ] }, { selected: limit } %>
            </div>

            <div class="relationships-control">
              <%= form.label :metric, t("relationships.graph.metric") %>
              <%= form.select :metric, [
                [ t("relationships.graph.metric_shared_matches"), "shared_matches" ],
                [ t("relationships.graph.metric_win_rate"), "win_rate" ],
                [ t("relationships.graph.metric_goals_assists"), "goals_assists" ]
              ], { selected: metric } %>
            </div>

            <div class="relationships-control">
              <%= form.label :player_filter, t("relationships.graph.player_filter"), class: "sr-only" %>
              <%= form.search_field :player_filter, value: graph_player_filter, placeholder: t("relationships.graph.player_filter") %>
            </div>

            <%= form.submit t("relationships.graph.filter"), class: "dashboard-button relationships-controls__submit" %>
          <% end %>

          <div class="synergy-graph-legend">
            <h2><%= t("relationships.graph.legend_title") %></h2>
            <ul>
              <li><%= t("relationships.graph.legend_line_width") %></li>
              <li><span class="synergy-graph-legend__line synergy-graph-legend__line--high"></span><%= t("relationships.graph.legend_high") %></li>
              <li><span class="synergy-graph-legend__line synergy-graph-legend__line--medium"></span><%= t("relationships.graph.legend_medium") %></li>
              <li><span class="synergy-graph-legend__line synergy-graph-legend__line--low"></span><%= t("relationships.graph.legend_low") %></li>
            </ul>
          </div>

        </aside>
      </div>
    <% else %>
  <%= form_with url: relationships_path, method: :get, local: true, class: "relationships-controls", data: { turbo_frame: "relationships_results" } do |form| %>
    <%= form.hidden_field :tab, value: active_tab %>
    <%= form.hidden_field :player_id, value: player_id if player_id.present? %>
    <%= form.hidden_field :sort, value: sort_column if sort_column.present? %>
    <%= form.hidden_field :sort_direction, value: sort_direction if sort_direction.present? %>

    <div class="relationships-control">
      <%= form.label :direction, t("relationships.controls.direction") %>
      <%= form.select :direction, [[ t("relationships.controls.best"), "best" ], [ t("relationships.controls.worst"), "worst" ]], { selected: direction } %>
    </div>

    <div class="relationships-control">
      <%= form.label :limit, t("relationships.controls.limit") %>
      <%= form.select :limit, [[ "20", 20 ], [ "50", 50 ]], { selected: limit } %>
    </div>

    <div class="relationships-control">
      <%= form.label :minimum_shared_matches, t("relationships.controls.minimum_shared_matches") %>
      <%= form.number_field :minimum_shared_matches, value: minimum_shared_matches, min: 1, step: 1 %>
    </div>

    <div class="relationships-control relationships-control--search">
      <%= form.label :player_filter, t("relationships.controls.search_player"), class: "sr-only" %>
      <%= form.search_field :player_filter, value: player_filter, placeholder: t("relationships.controls.search_player") %>
    </div>

    <%= form.submit t("common.filter"), class: "dashboard-button relationships-controls__submit" %>
  <% end %>

  <div class="relationships-main">
    <section class="leaderboards-table-card relationships-table-card">
      <div class="leaderboards-table-card__header">
        <div>
          <h2><%= t("relationships.ranking.title.#{active_tab}") %></h2>
          <p><%= t("relationships.ranking.description.#{active_tab}") %></p>
        </div>
      </div>

      <% if combination_ranking.any? %>
        <% sorted_combination_ranking = relationship_sorted_ranking(combination_ranking, sort_column:, sort_direction:) %>
        <% relationship_sort_context = { season:, active_tab:, direction:, limit:, metric:, minimum_shared_matches:, player_filter:, player_id: } %>
        <div class="leaderboards-table-wrap">
          <table class="leaderboards-table relationship-duo-table relationship-ranking-table">
            <colgroup>
              <col class="relationship-ranking-table__rank">
              <col class="relationship-ranking-table__duet">
              <col class="relationship-ranking-table__matches">
              <col class="relationship-ranking-table__record">
              <col class="relationship-ranking-table__win-rate">
              <col class="relationship-ranking-table__offense">
            </colgroup>
            <thead>
              <tr>
                <th class="relationship-ranking-table__rank"><%= t("relationships.table.position") %></th>
                <th class="relationship-ranking-table__duet" aria-sort="<%= relationship_sort_aria("combination", sort_column, sort_direction) %>"><%= relationship_sort_link(column: "combination", label: relationship_combination_label(active_tab), sort_column:, sort_direction:, **relationship_sort_context) %></th>
                <th class="relationship-ranking-table__matches" aria-sort="<%= relationship_sort_aria("matches", sort_column, sort_direction) %>"><%= relationship_sort_link(column: "matches", label: t("relationships.table.matches"), sort_column:, sort_direction:, **relationship_sort_context) %></th>
                <th class="relationship-ranking-table__record" aria-sort="<%= relationship_sort_aria("record", sort_column, sort_direction) %>"><%= relationship_sort_link(column: "record", label: t("relationships.table.record"), sort_column:, sort_direction:, **relationship_sort_context) %></th>
                <th class="relationship-ranking-table__win-rate" aria-sort="<%= relationship_sort_aria("win_rate", sort_column, sort_direction) %>"><%= relationship_sort_link(column: "win_rate", label: t("relationships.table.win_rate"), sort_column:, sort_direction:, **relationship_sort_context) %></th>
                <th class="relationship-ranking-table__offense" aria-sort="<%= relationship_sort_aria("offense", sort_column, sort_direction) %>"><%= relationship_sort_link(column: "offense", label: t("relationships.table.offense"), sort_column:, sort_direction:, **relationship_sort_context) %></th>
              </tr>
            </thead>
            <tbody>
              <% sorted_combination_ranking.each_with_index do |result, index| %>
                <tr>
                  <td class="relationship-ranking-table__rank"><%= leaderboard_rank_badge(result.rank || index + 1) %></td>
                  <td class="relationship-ranking-table__duet">
                    <div class="relationship-group-cell">
                      <% result.players.each_with_index do |player, player_index| %>
                        <%= render "shared/player_identity_pill", player:, size: :sm, variant: :default %>
                        <% unless player_index == result.players.size - 1 %>
                          <span class="relationship-group-plus" aria-hidden="true">+</span>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                  <td class="relationship-ranking-table__matches">
                    <strong class="relationship-stat-main"><%= result.shared_matches_count %></strong>
                  </td>
                  <td class="relationship-ranking-table__record">
                    <span class="relationship-record"><%= result.wins %>-<%= result.draws %>-<%= result.losses %></span>
                  </td>
                  <td class="relationship-ranking-table__win-rate">
                    <strong class="<%= relationship_win_rate_class(result.win_rate) %>"><%= result.win_rate ? t("relationships.table.win_rate_value", value: result.win_rate) : "—" %></strong>
                  </td>
                  <td class="relationship-ranking-table__offense">
                    <div class="relationship-offense">
                      <strong class="relationship-offense__value"><%= result.goals_assists %> G+A</strong>
                      <span class="relationship-offense__details">
                        <%= result.goals %>G • <%= result.assists %>A • <%= t("relationships.labels.mutual_assists", count: result.mutual_assists) %>
                      </span>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="relationship-mobile-ranking" aria-label="<%= t("relationships.ranking.title.#{active_tab}") %>">
          <div class="relationship-mobile-ranking__header">
            <span><%= t("relationships.table.position") %></span>
            <span><%= relationship_sort_link(column: "combination", label: relationship_combination_label(active_tab), sort_column:, sort_direction:, **relationship_sort_context) %></span>
            <span><%= relationship_sort_link(column: "matches", label: t("relationships.table.matches"), sort_column:, sort_direction:, **relationship_sort_context) %></span>
            <span><%= relationship_sort_link(column: "offense", label: "G+A", sort_column:, sort_direction:, **relationship_sort_context) %></span>
            <span><%= relationship_sort_link(column: "mutual_assists", label: t("relationships.table.mutual_assists_mobile"), sort_column:, sort_direction:, **relationship_sort_context) %></span>
          </div>

          <% sorted_combination_ranking.each_with_index do |result, index| %>
            <article class="relationship-mobile-ranking__row">
              <div class="relationship-mobile-ranking__rank">
                <%= leaderboard_rank_badge(result.rank || index + 1) %>
              </div>

              <div class="relationship-mobile-ranking__players">
                <% result.players.each do |player| %>
                  <%= link_to player_path(player),
                    class: "relationship-mobile-player",
                    style: "--player-color: #{player.profile_color}",
                    title: player.name,
                    aria: { label: player.name },
                    data: { turbo_frame: "_top" } do %>
                    <span class="relationship-mobile-player__avatar" aria-hidden="true">
                      <%= safe_lucide_icon(player.profile_icon_name, fallback: PlayerIdentity::DEFAULT_ICON, class_name: "ui-icon") %>
                    </span>
                    <span class="relationship-mobile-player__name"><%= player.name %></span>
                  <% end %>
                <% end %>
              </div>

              <div class="relationship-mobile-ranking__matches">
                <strong><%= result.shared_matches_count %></strong>
                <span><%= result.win_rate ? t("relationships.table.win_rate_value", value: result.win_rate) : "—" %></span>
              </div>

              <div class="relationship-mobile-ranking__offense">
                <strong><%= result.goals_assists %></strong>
                <span>(<%= result.goals %>g + <%= result.assists %>a)</span>
              </div>

              <div class="relationship-mobile-ranking__mutual">
                <strong><%= result.mutual_assists %></strong>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="relationships-empty relationships-empty--results">
          <h3><%= t("relationships.empty.results_title") %></h3>
          <p><%= t("relationships.empty.results_body") %></p>
        </div>
      <% end %>
    </section>

  </div>

  <section class="relationships-helper-card">
    <h2><%= t("relationships.how_to_read.title") %></h2>
    <p><%= t("relationships.how_to_read.body") %></p>
  </section>
  <% end %>
  <% end %>
</section>
