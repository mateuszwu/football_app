<% content_for :title, "#{t("players.edit_submission")} - #{t("app.name")}" %>

<section class="section" id="player-edit">
  <div class="section__header">
    <p class="eyebrow"><%= t("players.your_submission") %></p>
    <h1><%= t("players.edit_submission") %></h1>
    <p><%= t("players.edit_intro") %></p>
  </div>

  <% if player.errors.any? %>
    <div class="form-errors">
      <p><%= t("common.form_errors") %></p>
      <ul>
        <% player.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: player, class: "admin-form" do |form| %>
    <div class="form-field">
      <%= form.label :name, t("players.name") %>
      <%= form.text_field :name, required: true %>
    </div>

    <div class="form-field">
      <%= form.label :nickname, t("players.nickname") %>
      <%= form.text_field :nickname, required: true %>
    </div>

    <div class="form-field">
      <%= form.label :phone, t("players.phone") %>
      <%= form.telephone_field :phone %>
    </div>

    <div class="form-field">
      <%= form.label :description, t("players.description") %>
      <%= form.text_area :description, required: true, rows: 4 %>
    </div>

    <div class="form-field">
      <%= form.label :role_code, t("players.role") %>
      <%= form.select :role_code, role_options(Player::ROLE_CODES), {}, required: true %>
    </div>

    <div class="form-actions">
      <%= form.submit t("common.save"), class: "button button--primary" %>
      <%= link_to t("common.back"), root_path(anchor: "players"), class: "button button--secondary" %>
    </div>
  <% end %>
</section>
