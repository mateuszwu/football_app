<% content_for :title, "#{player.name} - Football App" %>

<section class="section player-profile">
  <div class="section__header">
    <p class="eyebrow">Profil zawodnika</p>
    <h1><%= player.name %></h1>
    <p><%= player.nickname %> &middot; <%= player.role_code %></p>
    <p>
      Elo globalne: <strong><%= player.elo %></strong>
      <% if profile.selected_season.present? %>
        &middot;
        Elo sezonu <%= profile.selected_season.name %>: <strong><%= profile.season_stat&.elo || "-" %></strong>
      <% end %>
    </p>
  </div>

  <div class="player-profile__body">
    <h2>Opis</h2>
    <p><%= player.description %></p>
  </div>

  <div class="player-profile__body">
    <% if profile.available_seasons.any? %>
      <%= form_with url: player_path(player), method: :get, local: true, class: "admin-form" do |form| %>
        <div class="form-field">
          <%= form.label :season_id, "Sezon" %>
          <%= form.select :season_id, options_from_collection_for_select(profile.available_seasons, :id, :name, profile.selected_season&.id) %>
        </div>
        <div class="form-actions">
          <%= form.submit "Filtruj", class: "button button--secondary" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="summary-grid">
    <article class="summary-card">
      <span class="summary-card__label">Mecze</span>
      <strong><%= profile.matches_count %></strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label">Bilans</span>
      <strong><%= [ profile.wins, profile.draws, profile.losses ].join("-") %></strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label">Win rate</span>
      <strong><%= profile.win_rate %>%</strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label">Gole / asysty</span>
      <strong><%= "#{profile.season_stat&.goals || 0} / #{profile.season_stat&.assists || 0}" %></strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label">MVP / DEF</span>
      <strong><%= "#{profile.season_stat&.mvp_votes_count || 0} / #{profile.season_stat&.def_votes_count || 0}" %></strong>
    </article>
  </div>

  <div class="player-profile__body">
    <h2>Historia meczow</h2>

    <% if profile.match_entries.any? %>
      <ul>
        <% profile.match_entries.each do |entry| %>
          <li>
            <strong><%= entry.match.match_day.played_on %></strong>
            <span><%= entry.match.match_day.season.name %></span>
            <span><%= entry.match.home_score %>:<%= entry.match.away_score %></span>
            <span><%= entry.team.result %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>Brak rozegranych meczow.</p>
    <% end %>
  </div>
</section>
