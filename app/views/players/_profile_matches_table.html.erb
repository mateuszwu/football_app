<section class="player-profile-table-card">
  <div class="leaderboards-table-card__header">
    <div>
      <h2><%= title %></h2>
      <p><%= t("players.profile.matches.summary", matches: profile.summary.fetch(:matches), goals: profile.summary.fetch(:goals), assists: profile.summary.fetch(:assists), goals_assists: profile.summary.fetch(:goals_assists)) %></p>
    </div>
  </div>

  <% if matches.any? %>
    <div class="leaderboards-table-wrap">
      <table class="leaderboards-table player-profile-table">
        <thead>
          <tr>
            <th><%= t("players.profile.matches.date") %></th>
            <th><%= t("players.profile.matches.match_day") %></th>
            <th><%= t("players.profile.matches.team") %></th>
            <th><%= t("players.profile.matches.score") %></th>
            <th><%= t("players.profile.matches.result") %></th>
            <th class="is-numeric"><%= t("players.profile.matches.goals") %></th>
            <th class="is-numeric"><%= t("players.profile.matches.assists") %></th>
            <th class="is-numeric"><%= t("players.profile.matches.elo_change") %></th>
            <th><%= t("players.profile.matches.badges") %></th>
            <th><%= t("players.profile.matches.link") %></th>
          </tr>
        </thead>
        <tbody>
          <% matches.each do |entry| %>
            <tr>
              <td><%= l(entry.date) %></td>
              <td><%= entry.match_day.played_on %></td>
              <td><%= entry.team.name %></td>
              <td><%= entry.score %></td>
              <td><span class="player-profile-match-result player-profile-match-result--<%= entry.result %>"><%= player_profile_result_label(entry.result) %></span></td>
              <td class="is-numeric"><%= entry.goals %></td>
              <td class="is-numeric"><%= entry.assists %></td>
              <td class="is-numeric"><%= player_profile_signed_delta(entry.elo_delta) %></td>
              <td>
                <% entry.award_types.each do |award_type| %>
                  <span class="player-profile-award-badge player-profile-award-badge--<%= award_type.downcase %>"><%= award_type %></span>
                <% end %>
              </td>
              <td><%= link_to t("players.profile.matches.view_match"), match_path(entry.match), class: "roster-card__link" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if paginated && profile.paginated_matches.total_pages > 1 %>
      <div class="player-profile-pagination">
        <% if profile.paginated_matches.prev_page %>
          <%= link_to t("common.previous"), player_path(player, season_id: profile.season&.id, tab: "matches", page: profile.paginated_matches.prev_page), class: "button button--secondary" %>
        <% end %>
        <span><%= profile.paginated_matches.page %> / <%= profile.paginated_matches.total_pages %></span>
        <% if profile.paginated_matches.next_page %>
          <%= link_to t("common.next"), player_path(player, season_id: profile.season&.id, tab: "matches", page: profile.paginated_matches.next_page), class: "button button--secondary" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <%= render "players/profile_empty", title: t("players.profile.empty.no_matches_title"), body: t("players.profile.empty.no_matches_body") %>
  <% end %>
</section>
