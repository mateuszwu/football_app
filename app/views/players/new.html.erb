<% content_for :title, "Dolacz jako zawodnik - Football App" %>

<section class="section" id="player-submission">
  <div class="section__header">
    <p class="eyebrow">Dolacz do gry</p>
    <h1>Zgloszenie zawodnika</h1>
    <p>Wypelnij formularz, aby przeslac profil do akceptacji administratora.</p>
  </div>

  <% if player.errors.any? %>
    <div class="form-errors">
      <p>Popraw bledy formularza:</p>
      <ul>
        <% player.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: player, class: "admin-form" do |form| %>
    <div class="form-field">
      <%= form.label :name, "Imie i nazwisko" %>
      <%= form.text_field :name, required: true %>
    </div>

    <div class="form-field">
      <%= form.label :nickname, "Nick" %>
      <%= form.text_field :nickname, required: true %>
    </div>

    <div class="form-field">
      <%= form.label :phone, "Telefon" %>
      <%= form.telephone_field :phone, required: true %>
    </div>

    <div class="form-field">
      <%= form.label :description, "Opis" %>
      <%= form.text_area :description, required: true, rows: 4 %>
    </div>

    <div class="form-field">
      <%= form.label :role_code, "Rola" %>
      <%= form.select :role_code, Player::ROLE_CODES, {}, required: true %>
    </div>

    <div class="form-actions">
      <%= form.submit "Wyslij zgloszenie", class: "button button--primary" %>
      <%= link_to "Wroc", root_path(anchor: "players"), class: "button button--secondary" %>
    </div>
  <% end %>
</section>
