<% content_for :title, "#{match.home_team.name} vs #{match.away_team.name} - Football App" %>

<%
  timer_seconds = match.elapsed_seconds
  timer_minutes = timer_seconds / 60
  timer_remainder_seconds = timer_seconds % 60
%>

<section class="live-match">
  <div class="section__header">
    <p class="eyebrow">Live match</p>
    <h1><%= match.home_team.name %> vs <%= match.away_team.name %></h1>
    <p>
      Sezon:
      <%= link_to match.match_day.season.name, season_path(match.match_day.season) %>
      ·
      Match day:
      <%= match.match_day.played_on %>
    </p>
  </div>

  <div class="live-match__scoreboard">
    <article class="live-match__team">
      <p class="live-match__team-label">Home</p>
      <h2><%= match.home_team.name %></h2>
      <strong class="live-match__score"><%= match.home_score %></strong>
    </article>

    <div class="live-match__status-card">
      <p class="status-badge"><%= match.finished? ? "finished" : (match.in_progress? ? "in_progress" : "not_started") %></p>

      <div
        class="live-match__timer"
        data-controller="match-timer"
        data-match-timer-started-at-value="<%= match.started_at&.iso8601 %>"
        data-match-timer-finished-at-value="<%= match.finished_at&.iso8601 %>"
        data-match-timer-status-value="<%= match.finished? ? "finished" : (match.in_progress? ? "in_progress" : "not_started") %>"
      >
        <p class="live-match__timer-label">Match timer</p>
        <p class="live-match__timer-value" data-match-timer-target="clock">
          <%= format("%02d:%02d", timer_minutes, timer_remainder_seconds) %>
        </p>
      </div>

      <% if match.finished? %>
        <p>
          <% if match.draw? %>
            Match finished as a draw.
          <% else %>
            Winner: <strong><%= match.winner.name %></strong>
          <% end %>
        </p>
      <% elsif match.in_progress? %>
        <p>Started at <%= match.started_at.strftime("%H:%M") %></p>
      <% else %>
        <p>Kick-off not started yet.</p>
      <% end %>
    </div>

    <article class="live-match__team">
      <p class="live-match__team-label">Away</p>
      <h2><%= match.away_team.name %></h2>
      <strong class="live-match__score"><%= match.away_score %></strong>
    </article>
  </div>

  <div class="live-match__lineups">
    <article class="live-match__lineup">
      <h2><%= match.home_team.name %> lineup</h2>

      <% if match.home_team.players.any? %>
        <ul class="live-match__players">
          <% match.home_team.players.order(:name).each do |player| %>
            <li>
              <strong><%= player.name %></strong>
              <span><%= player.nickname %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">No players assigned yet.</p>
      <% end %>
    </article>

    <article class="live-match__lineup">
      <h2><%= match.away_team.name %> lineup</h2>

      <% if match.away_team.players.any? %>
        <ul class="live-match__players">
          <% match.away_team.players.order(:name).each do |player| %>
            <li>
              <strong><%= player.name %></strong>
              <span><%= player.nickname %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">No players assigned yet.</p>
      <% end %>
    </article>
  </div>

  <% if admin_signed_in? %>
    <section class="live-match__admin-panel">
      <h2>Add goal</h2>

      <% if match.in_progress? %>
        <div class="live-match__goal-forms">
          <% [match.home_team, match.away_team].each do |team| %>
            <article class="live-match__goal-form-card">
              <h3><%= team.name %></h3>

              <%= form_with url: match_goals_path(match), scope: :match_goal, method: :post, local: true, class: "admin-form" do |form| %>
                <%= form.hidden_field :scoring_team_id, value: team.id %>

                <label class="form-field">
                  <span>Scorer</span>
                  <%= form.select :scorer_id, options_from_collection_for_select(team.players.order(:name), :id, :name), {}, required: true %>
                </label>

                <%= form.submit "Add goal for #{team.name}", class: "button button--primary" %>
              <% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="empty-state">Goals can be added only while the match is in progress.</p>
      <% end %>
    </section>
  <% end %>
</section>
