<% content_for :title, "#{match.home_team.name} vs #{match.away_team.name} - Football App" %>

<%
  timer_seconds = match.elapsed_seconds
  timer_minutes = timer_seconds / 60
  timer_remainder_seconds = timer_seconds % 60
%>

<section class="live-match">
  <div class="section__header">
    <p class="eyebrow">Live match</p>
    <h1><%= match.home_team.name %> vs <%= match.away_team.name %></h1>
    <p>
      Sezon:
      <%= link_to match.match_day.season.name, season_path(match.match_day.season) %>
      ·
      Match day:
      <%= match.match_day.played_on %>
    </p>
  </div>

  <div class="live-match__scoreboard">
    <article class="live-match__team">
      <p class="live-match__team-label">Home</p>
      <h2><%= match.home_team.name %></h2>
      <strong class="live-match__score"><%= match.home_score %></strong>

      <% home_goals = match.match_goals.active.includes(scorer_team_player: :player, assistant_team_player: :player).where(scoring_team: match.home_team).order(:scored_at) %>
      <% if home_goals.any? %>
        <ul class="live-match__team-goals">
          <% home_goals.each do |goal| %>
            <li>
              <span class="goal-marker">GOAL</span> <%= goal.scorer.nickname.presence || goal.scorer.name %>
              <% details = [] %>
              <% if match.started_at.present? %>
                <% details << "#{match.elapsed_seconds(goal.scored_at) / 60}'" %>
              <% end %>
              <% if goal.assistant.present? %>
                <% details << "ass: #{goal.assistant.nickname.presence || goal.assistant.name}" %>
              <% end %>
              <% if details.any? %>
                <span class="goal-time">(<%= details.join(", ") %>)</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </article>

    <div class="live-match__status-card">
      <p class="status-badge"><%= match.finished? ? "finished" : (match.in_progress? ? "in_progress" : "not_started") %></p>

      <div
        class="live-match__timer"
        data-controller="match-timer"
        data-match-timer-started-at-value="<%= match.started_at&.iso8601 %>"
        data-match-timer-finished-at-value="<%= match.finished_at&.iso8601 %>"
        data-match-timer-status-value="<%= match.finished? ? "finished" : (match.in_progress? ? "in_progress" : "not_started") %>"
      >
        <p class="live-match__timer-label">Match timer</p>
        <p class="live-match__timer-value" data-match-timer-target="clock">
          <%= format("%02d:%02d", timer_minutes, timer_remainder_seconds) %>
        </p>
      </div>

      <% if match.finished? %>
        <p>
          <% if match.draw? %>
            Match finished as a draw.
          <% else %>
            Winner: <strong><%= match.winner.name %></strong>
          <% end %>
        </p>
      <% elsif match.in_progress? %>
        <p>Started at <%= match.started_at.strftime("%H:%M") %></p>
      <% else %>
        <p>Kick-off not started yet.</p>
      <% end %>
    </div>

    <article class="live-match__team">
      <p class="live-match__team-label">Away</p>
      <h2><%= match.away_team.name %></h2>
      <strong class="live-match__score"><%= match.away_score %></strong>

      <% away_goals = match.match_goals.active.includes(scorer_team_player: :player, assistant_team_player: :player).where(scoring_team: match.away_team).order(:scored_at) %>
      <% if away_goals.any? %>
        <ul class="live-match__team-goals">
          <% away_goals.each do |goal| %>
            <li>
              <span class="goal-marker">GOAL</span> <%= goal.scorer.nickname.presence || goal.scorer.name %>
              <% details = [] %>
              <% if match.started_at.present? %>
                <% details << "#{match.elapsed_seconds(goal.scored_at) / 60}'" %>
              <% end %>
              <% if goal.assistant.present? %>
                <% details << "ass: #{goal.assistant.nickname.presence || goal.assistant.name}" %>
              <% end %>
              <% if details.any? %>
                <span class="goal-time">(<%= details.join(", ") %>)</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </article>
  </div>

  <div class="live-match__lineups">
    <article class="live-match__lineup">
      <h2><%= match.home_team.name %> lineup</h2>

      <% if match.home_team.players.any? %>
        <ul class="live-match__players">
          <% match.home_team.players.order(:name).each do |player| %>
            <li>
              <strong><%= player.name %></strong>
              <span><%= player.nickname %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">No players assigned yet.</p>
      <% end %>
    </article>

    <article class="live-match__lineup">
      <h2><%= match.away_team.name %> lineup</h2>

      <% if match.away_team.players.any? %>
        <ul class="live-match__players">
          <% match.away_team.players.order(:name).each do |player| %>
            <li>
              <strong><%= player.name %></strong>
              <span><%= player.nickname %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">No players assigned yet.</p>
      <% end %>
    </article>
  </div>

<% recent_goals = match.match_goals.active.includes(:scoring_team, scorer_team_player: :player, assistant_team_player: :player).order(scored_at: :desc) %>
  <% if recent_goals.any? %>
    <section class="live-match__events">
      <h2>Recent events</h2>
      <ol class="live-match__event-list">
        <% recent_goals.each do |goal| %>
          <li class="live-match__event">
            <span class="live-match__event-icon">GOAL</span>
            <span class="live-match__event-body">
              <strong><%= goal.scorer.nickname.presence || goal.scorer.name %></strong>
              <% if goal.assistant.present? %>
                <span class="live-match__event-assist">(ass: <%= goal.assistant.nickname.presence || goal.assistant.name %>)</span>
              <% end %>
              &mdash;
              <span class="live-match__event-team"><%= goal.scoring_team.name %></span>
            </span>
            <% if match.started_at.present? %>
              <span class="live-match__event-time"><%= match.elapsed_seconds(goal.scored_at) / 60 %>'</span>
            <% end %>
            <% if admin_signed_in? && match.started_at.present? %>
              <%= button_to "Undo", match_goal_path(match, goal), method: :delete, class: "button button--danger button--small", data: { turbo_confirm: "Remove this goal?" } %>
            <% end %>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>

  <% if admin_signed_in? %>
    <section class="live-match__admin-panel">
      <% if match.not_started? %>
        <h2>Pre-match lineup editor</h2>
        <div class="form-actions">
          <%= button_to "Reset to baseline", reset_to_baseline_match_path(match), method: :patch, class: "button button--secondary" %>
          <%= button_to "Copy previous match", copy_previous_lineup_match_path(match), method: :patch, class: "button button--secondary" %>
          <%= button_to "Start match", start_match_path(match), method: :patch, class: "button button--primary", data: { turbo_confirm: "Start this match with the current lineup?" } %>
        </div>

        <%= form_with url: update_lineup_match_path(match), scope: :match, method: :patch, local: true, class: "admin-form" do %>
          <div
            class="lineup-editor"
            data-controller="lineup-editor"
            data-lineup-editor-input-name-prefix-value="match[teams_data]"
            data-lineup-editor-players-value="<%= lineup_editor_state[:players].to_json %>"
            data-lineup-editor-teams-value="<%= lineup_editor_state[:teams].map { |team| { id: team.id, name: team.name, player_ids: team.player_ids.map(&:to_s) } }.to_json %>"
          >
            <div class="form-actions">
              <button type="button" class="button button--secondary" data-action="lineup-editor#addTeam">Add team</button>
            </div>

            <div class="lineup-editor__columns">
              <section class="lineup-column" data-lineup-column="pool">
                <header class="lineup-column__header">
                  <h3>Bench</h3>
                  <p>Drag players between teams or click two players to swap them.</p>
                </header>
                <div class="lineup-column__list" data-lineup-list="pool" data-lineup-editor-target="pool"></div>
              </section>

              <div class="lineup-editor__dynamic-columns" data-lineup-editor-target="columnsContainer"></div>
            </div>
          </div>

          <div class="form-actions">
            <%= submit_tag "Save lineup", class: "button button--primary" %>
          </div>
        <% end %>
      <% end %>

      <% if match.in_progress? %>
        <div class="form-actions">
          <%= button_to "Finish match", finish_match_path(match), method: :patch, class: "button button--danger", data: { turbo_confirm: "Finish this match?" } %>
        </div>
      <% end %>

      <h2>Add goal</h2>

      <% if match.started_at.present? %>
        <div class="live-match__goal-forms">
          <% [match.home_team, match.away_team].each do |team| %>
            <article class="live-match__goal-form-card">
              <h3><%= team.name %></h3>

              <%= form_with url: match_goals_path(match), scope: :match_goal, method: :post, local: true, class: "admin-form" do |form| %>
                <%= form.hidden_field :scoring_team_id, value: team.id %>

                <label class="form-field">
                  <span>Scorer</span>
                  <%= form.select :scorer_team_player_id, options_from_collection_for_select(team.team_players.includes(:player).order(:player_name), :id, :player_name), {}, required: true %>
                </label>

                <label class="form-field">
                  <span>Assistant (optional)</span>
                  <%= form.select :assistant_team_player_id, options_from_collection_for_select(team.team_players.includes(:player).order(:player_name), :id, :player_name), { include_blank: "No assist" } %>
                </label>

                <%= form.submit "Add goal for #{team.name}", class: "button button--primary" %>
              <% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="empty-state">Goals can be added only after the match starts.</p>
      <% end %>
    </section>
  <% end %>
</section>
