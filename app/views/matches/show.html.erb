<% content_for :title, "#{match.home_team.name} vs #{match.away_team.name} - #{t("app.name")}" %>

<section class="match-page">
  <div class="match-page__header">
    <p class="match-page__eyebrow"><%= t("matches.show.eyebrow") %></p>
    <div>
      <h1><%= match.home_team.name %> vs <%= match.away_team.name %></h1>
      <p>
        <%= summary.season.name %>
        ·
        <%= t("matches.show.match_day_with_date", date: summary.match_day.played_on) %>
        ·
        <%= t("matches.show.match_number", number: match.id) %>
      </p>
    </div>
  </div>

  <div class="match-time-strip" aria-label="<%= t("matches.show.time_strip") %>">
    <div class="match-time-strip__item">
      <span class="match-time-strip__icon"><%= safe_lucide_icon("clock", fallback: "circle", class_name: "ui-icon ui-icon--sm") %></span>
      <span><%= t("matches.show.start") %></span>
      <strong><%= match_report_clock(summary.time.fetch(:started_at)) %></strong>
    </div>
    <div class="match-time-strip__item">
      <span class="match-time-strip__icon"><%= safe_lucide_icon("flag", fallback: "circle", class_name: "ui-icon ui-icon--sm") %></span>
      <span><%= t("matches.show.end") %></span>
      <strong><%= match_report_clock(summary.time.fetch(:ended_at)) %></strong>
    </div>
    <div class="match-time-strip__item">
      <span class="match-time-strip__icon"><%= safe_lucide_icon("timer", fallback: "clock", class_name: "ui-icon ui-icon--sm") %></span>
      <span><%= t("matches.show.duration") %></span>
      <strong><%= match_report_duration(summary.time.fetch(:duration_seconds)) %></strong>
    </div>
    <div class="match-time-strip__item match-time-strip__item--status">
      <span class="match-time-strip__icon"><%= safe_lucide_icon("badge-check", fallback: "check-circle", class_name: "ui-icon ui-icon--sm") %></span>
      <span><%= t("matches.show.status") %></span>
      <strong class="match-status-pill"><%= summary.status %></strong>
    </div>
  </div>

  <section class="match-score-hero">
    <% home_team = summary.teams.fetch(:home) %>
    <% away_team = summary.teams.fetch(:away) %>
    <% home_events = summary.timeline.select { |event| event.fetch(:team) == home_team } %>
    <% away_events = summary.timeline.select { |event| event.fetch(:team) == away_team } %>

    <article class="match-score-team match-score-team--home">
      <div class="match-score-team__header">
        <span class="match-team-mark"><%= safe_lucide_icon("shield", fallback: "circle", class_name: "ui-icon") %></span>
        <h2><%= home_team.name %></h2>
      </div>

      <%= render partial: "matches/team_goals", locals: { events: home_events } %>
    </article>

    <div class="match-score-center">
      <strong class="match-score-value"><%= summary.score.fetch(:home) %> : <%= summary.score.fetch(:away) %></strong>
      <span class="match-result-badge"><%= summary.score.fetch(:result_label) %></span>
      <p><%= summary.status %> · <%= match_report_duration(summary.time.fetch(:duration_seconds)) %></p>
    </div>

    <article class="match-score-team match-score-team--away">
      <div class="match-score-team__header">
        <span class="match-team-mark"><%= safe_lucide_icon("shield-check", fallback: "shield", class_name: "ui-icon") %></span>
        <h2><%= away_team.name %></h2>
      </div>

      <%= render partial: "matches/team_goals", locals: { events: away_events } %>
    </article>
  </section>

  <section class="match-summary-grid" aria-label="<%= t("matches.show.quick_summary") %>">
    <% summary.summary_cards.each do |card| %>
      <% first_event = card.fetch(:key) == :first_goal ? summary.timeline.first : nil %>
      <% last_event = card.fetch(:key) == :last_goal ? summary.timeline.last : nil %>
      <% icon_name = {
        goals: "target",
        assists: "handshake",
        own_goals: "shield-alert",
        first_goal: "flag",
        last_goal: "timer",
        awards: "award"
      }.fetch(card.fetch(:key), "circle") %>
      <article class="match-summary-card">
        <span class="match-summary-card__icon"><%= safe_lucide_icon(icon_name, fallback: "circle", class_name: "ui-icon ui-icon--sm") %></span>
        <div>
          <span class="match-summary-card__label"><%= card.fetch(:label) %></span>
          <% if first_event.present? %>
            <strong><%= first_event.fetch(:scorer).name %></strong>
            <small><%= match_report_minute(first_event.fetch(:occurred_at_seconds)) %> · <%= match_report_compact_score(first_event.fetch(:score_after)) %></small>
          <% elsif last_event.present? %>
            <strong><%= last_event.fetch(:scorer).name %></strong>
            <small><%= match_report_minute(last_event.fetch(:occurred_at_seconds)) %> · <%= match_report_compact_score(last_event.fetch(:score_after)) %></small>
          <% elsif card.fetch(:key) == :awards %>
            <strong><%= t("matches.show.summary_cards.awards_value", mvp: summary.awards.fetch(:mvp).present? ? 1 : 0, def: summary.awards.fetch(:def).present? ? 1 : 0) %></strong>
          <% else %>
            <strong><%= card.fetch(:value) %></strong>
          <% end %>
        </div>
      </article>
    <% end %>
  </section>

  <div class="match-report-layout">
    <main class="match-report-main">
      <section class="match-report-card">
        <div class="match-report-card__header">
          <div>
            <h2><%= t("matches.show.timeline.title") %></h2>
            <p><%= t("matches.show.timeline.subtitle") %></p>
          </div>
          <% if summary.score_progression.any? %>
            <div class="match-score-progression">
              <%= summary.score_progression.map { |score| match_report_compact_score(score) }.join(" → ") %>
            </div>
          <% end %>
        </div>

        <% if summary.timeline.any? %>
          <ol class="match-timeline">
            <% summary.timeline.each do |event| %>
              <li class="match-timeline-row match-timeline-row--<%= event.fetch(:event_type) %>">
                <span class="match-event-time"><%= match_report_minute(event.fetch(:occurred_at_seconds)) %></span>
                <div class="match-timeline__body">
                  <div class="match-event-main">
                    <span class="match-event-type"><%= event.fetch(:own_goal) ? t("matches.show.timeline.own_goal_badge") : t("matches.goal") %></span>
                    <strong><%= event.fetch(:scorer).name %></strong>
                  </div>
                  <p>
                    <% if event.fetch(:own_goal) %>
                      <%= t("matches.show.timeline.for_team", team: event.fetch(:team).name) %>
                    <% elsif event.fetch(:assister).present? %>
                      <%= t("matches.show.timeline.assist", player: event.fetch(:assister).name) %>
                      ·
                      <%= event.fetch(:team).name %>
                    <% end %>
                  </p>
                  <div class="match-timeline__tags">
                    <span><%= event.fetch(:own_goal) ? t("matches.show.timeline.own_goal_badge") : t("matches.goal") %></span>
                    <% if event.fetch(:first_goal) %>
                      <span><%= t("matches.show.timeline.first_goal") %></span>
                    <% end %>
                    <% if event.fetch(:equalizer) %>
                      <span><%= t("matches.show.timeline.equalizer") %></span>
                    <% end %>
                    <% if event.fetch(:go_ahead_goal) %>
                      <span><%= t("matches.show.timeline.go_ahead") %></span>
                    <% end %>
                  </div>
                </div>
                <strong class="match-event-score"><%= match_report_compact_score(event.fetch(:score_after)) %></strong>
                <% if admin_signed_in? %>
                  <%= button_to t("matches.undo"), match_goal_path(match, event.fetch(:id)), method: :delete, class: "button button--danger button--small", data: { turbo_confirm: t("matches.remove_goal_confirm") } %>
                <% end %>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="empty-state"><%= t("matches.show.timeline.empty") %></p>
        <% end %>
      </section>

      <section class="match-report-card">
        <div class="match-report-card__header">
          <div>
            <h2><%= t("matches.show.rosters.title") %></h2>
            <p><%= t("matches.show.rosters.subtitle") %></p>
          </div>
        </div>

        <div class="match-rosters">
          <% summary.team_rosters.each do |roster| %>
            <article class="match-roster-card">
              <div class="match-roster-card__header">
                <span class="match-team-mark match-team-mark--small"><%= safe_lucide_icon("shield", fallback: "circle", class_name: "ui-icon ui-icon--sm") %></span>
                <h3><%= roster.fetch(:team).name %></h3>
              </div>

              <% if roster.fetch(:players).any? %>
                <div class="match-roster-table">
                  <div class="match-roster-table__head">
                    <span><%= t("matches.show.rosters.player") %></span>
                    <span>G</span>
                    <span>A</span>
                    <span>SG</span>
                    <span><%= t("matches.show.rosters.badges") %></span>
                  </div>
                  <% roster.fetch(:players).each do |row| %>
                    <div class="match-roster-table__row">
                      <div class="match-roster-player">
                        <span class="match-player-avatar"><%= match_player_initials(row.fetch(:player)) %></span>
                        <strong><%= match_player_profile_link(row.fetch(:player), class_name: "match-player-link") %></strong>
                      </div>
                      <span><%= row.fetch(:goals) %></span>
                      <span><%= row.fetch(:assists) %></span>
                      <span><%= row.fetch(:own_goals) %></span>
                      <div class="match-roster-card__badges">
                        <% if row.fetch(:mvp) %>
                          <span>MVP</span>
                        <% end %>
                        <% if row.fetch(:def) %>
                          <span>DEF</span>
                        <% end %>
                        <% unless row.fetch(:mvp) || row.fetch(:def) %>
                          <span class="match-roster-card__empty-badge">—</span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="empty-state"><%= t("matches.no_players") %></p>
              <% end %>
            </article>
          <% end %>
        </div>
      </section>
    </main>

    <aside class="match-report-side">
      <section class="match-report-card">
        <div class="match-report-card__header">
          <div>
            <h2><%= t("matches.show.match_summary.title") %></h2>
            <p><%= t("matches.show.match_summary.subtitle") %></p>
          </div>
        </div>

        <dl class="match-summary-list">
          <% summary.match_summary.each do |row| %>
            <div>
              <dt><%= row.fetch(:label) %></dt>
              <dd>
                <% if [ :start, :end ].include?(row.fetch(:key)) %>
                  <%= match_report_clock(row.fetch(:value)) %>
                <% elsif [ :duration, :last_goal ].include?(row.fetch(:key)) && row.fetch(:value).is_a?(Integer) %>
                  <%= row.fetch(:key) == :duration ? match_report_duration(row.fetch(:value)) : match_report_minute(row.fetch(:value)) %>
                <% else %>
                  <%= row.fetch(:value) %>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      </section>

      <section class="match-report-card match-awards-card">
        <div class="match-report-card__header">
          <div>
            <h2><%= t("matches.show.awards.title") %></h2>
            <p><%= t("matches.show.awards.subtitle") %></p>
          </div>
        </div>

        <% if summary.awards.values.compact.any? %>
          <div class="match-awards">
            <% { mvp: "MVP", def: "DEF" }.each do |key, label| %>
              <% award = summary.awards.fetch(key) %>
              <% next if award.blank? %>

              <div>
                <span><%= label %></span>
                <strong><%= match_player_profile_link(award.fetch(:player), class_name: "match-player-link") %></strong>
                <small><%= match_report_votes_count(award.fetch(:votes_count)) %></small>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="empty-state"><%= t("matches.show.awards.empty") %></p>
        <% end %>
      </section>

      <section class="match-report-card match-day-cta-card">
        <div>
          <h2><%= t("matches.show.match_day_cta.title") %></h2>
          <p><%= t("matches.show.match_day_cta.subtitle", date: summary.match_day.played_on) %></p>
        </div>
        <%= link_to t("matches.show.match_day_cta.button"), season_path(summary.season), class: "button button--primary" %>
      </section>
    </aside>
  </div>

  <% if admin_signed_in? %>
    <section class="match-admin-panel">
      <% if match.not_started? %>
        <h2>Pre-match lineup editor</h2>
        <div class="form-actions">
          <%= button_to "Reset to baseline", reset_to_baseline_match_path(match), method: :patch, class: "button button--secondary" %>
          <%= button_to "Copy previous match", copy_previous_lineup_match_path(match), method: :patch, class: "button button--secondary" %>
          <%= button_to "Start match", start_match_path(match), method: :patch, class: "button button--primary", data: { turbo_confirm: "Start this match with the current lineup?" } %>
        </div>

        <%= form_with url: update_lineup_match_path(match), scope: :match, method: :patch, local: true, class: "admin-form" do %>
          <div
            class="lineup-editor"
            data-controller="lineup-editor"
            data-lineup-editor-input-name-prefix-value="match[teams_data]"
            data-lineup-editor-players-value="<%= lineup_editor_state[:players].to_json %>"
            data-lineup-editor-teams-value="<%= lineup_editor_state[:teams].map { |team| { id: team.id, name: team.name, player_ids: team.player_ids.map(&:to_s) } }.to_json %>"
          >
            <div class="form-actions">
              <button type="button" class="button button--secondary" data-action="lineup-editor#addTeam">Add team</button>
            </div>

            <div class="lineup-editor__columns">
              <section class="lineup-column" data-lineup-column="pool">
                <header class="lineup-column__header">
                  <h3>Bench</h3>
                  <p>Drag players between teams or click two players to swap them.</p>
                </header>
                <div class="lineup-column__list" data-lineup-list="pool" data-lineup-editor-target="pool"></div>
              </section>

              <div class="lineup-editor__dynamic-columns" data-lineup-editor-target="columnsContainer"></div>
            </div>
          </div>

          <div class="form-actions">
            <%= submit_tag "Save lineup", class: "button button--primary" %>
          </div>
        <% end %>
      <% end %>

      <% if match.in_progress? %>
        <div class="form-actions">
          <%= button_to "Finish match", finish_match_path(match), method: :patch, class: "button button--danger", data: { turbo_confirm: "Finish this match?" } %>
        </div>
      <% end %>

      <h2>Add goal</h2>

      <% if match.started_at.present? %>
        <div class="match-admin-panel__goal-forms">
          <% [ match.home_team, match.away_team ].each do |team| %>
            <article class="match-admin-panel__goal-form-card">
              <h3><%= team.name %></h3>

              <%= form_with url: match_goals_path(match), scope: :match_goal, method: :post, local: true, class: "admin-form" do |form| %>
                <%= form.hidden_field :scoring_team_id, value: team.id %>

                <label class="form-field">
                  <span>Scorer / own-goal player</span>
                  <%= form.select :scorer_team_player_id, options_from_collection_for_select(match.teams.includes(team_players: :player).flat_map(&:team_players).sort_by(&:player_name), :id, :player_name), {}, required: true %>
                </label>

                <label class="form-field">
                  <span>Assistant (optional)</span>
                  <%= form.select :assistant_team_player_id, options_from_collection_for_select(team.team_players.includes(:player).order(:player_name), :id, :player_name), { include_blank: "No assist" } %>
                </label>

                <label class="form-field form-field--checkbox">
                  <%= form.check_box :own_goal %>
                  <span>Own goal for <%= team.name %></span>
                </label>

                <%= form.submit "Add goal for #{team.name}", class: "button button--primary" %>
              <% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="empty-state">Goals can be added only after the match starts.</p>
      <% end %>
    </section>
  <% end %>
</section>
