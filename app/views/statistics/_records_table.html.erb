<% rows ||= [] %>
<% active_tab ||= "records" %>

<% if rows.any? %>
  <div class="leaderboards-table-wrap">
    <table class="leaderboards-table stats-records-table">
      <thead>
        <tr>
          <% records_columns = [
            [ :record, t("statistics.index.records.record") ],
            [ :match_or_player, t("statistics.index.records.match_or_player") ],
            [ :value, t("statistics.index.records.value") ]
          ] %>
          <% records_columns.each do |column, label| %>
            <th aria-sort="<%= statistics_sort_aria(active_tab, column, sort_column, sort_direction) %>">
              <%= statistics_sort_link(season:, tab: active_tab, column:, sort_column:, sort_direction:) { label } %>
            </th>
          <% end %>
          <th><%= t("statistics.index.table.link") %></th>
        </tr>
      </thead>
      <tbody>
        <% statistics_sorted_rows(rows, tab: active_tab, sort_column:, sort_direction:).each do |row| %>
          <tr>
            <td><%= t("statistics.index.records.#{row.fetch(:key)}") %></td>
            <td>
              <div class="statistics-record-subject">
                <% if row.fetch(:match).present? && row.fetch(:subject) == "#{row.fetch(:match).match_day.played_on} · ##{row.fetch(:match).id}" %>
                  <strong><%= statistics_match_meta(row.fetch(:match)) %></strong>
                <% else %>
                  <strong><%= statistics_row_value(row.fetch(:subject)) %></strong>
                <% end %>
                <% if row.fetch(:match).present? && row.fetch(:subject) != "#{row.fetch(:match).match_day.played_on} · ##{row.fetch(:match).id}" %>
                  <span><%= statistics_match_meta(row.fetch(:match)) %></span>
                <% elsif row.fetch(:detail).present? %>
                  <span><%= row.fetch(:detail) %></span>
                <% end %>
              </div>
            </td>
            <td><%= statistics_row_value(row.fetch(:value)) %></td>
            <td>
              <% if row.fetch(:path).present? %>
                <%= link_to t("statistics.index.table.view_match"), row.fetch(:path), class: "stats-card-link" %>
              <% else %>
                -
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render "statistics/empty", title: t("statistics.index.empty.no_timeline_title"), body: t("statistics.index.empty.no_timeline_body") %>
<% end %>
