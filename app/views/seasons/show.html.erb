<% content_for :title, "#{season.name} - Football App" %>

<section class="section season-stats">
  <div class="section__header">
    <p class="eyebrow">Statystyki sezonu</p>
    <h1><%= season.name %></h1>
    <p>
      <%= season.starts_on %>
      -
      <%= season.ends_on || "bez daty konca" %>
    </p>
  </div>

  <%= form_with url: season_path(season), method: :get, local: true, class: "admin-form" do |form| %>
    <div class="form-field">
      <%= form.label :season_id, "Sezon" %>
      <%= form.select :season_id, options_from_collection_for_select(available_seasons, :id, :name, season.id) %>
    </div>
    <div class="form-actions">
      <%= form.submit "Filtruj", class: "button button--secondary" %>
    </div>
  <% end %>

  <div class="summary-grid">
    <article class="summary-card">
      <span class="summary-card__label">Match days</span>
      <strong><%= season.match_days_count %></strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label">Zawodnicy</span>
      <strong><%= season.unique_players_count %></strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label">Wystepy</span>
      <strong><%= season.player_appearances_count %></strong>
    </article>
  </div>

  <div class="player-profile__body">
    <h2>Ranking Elo</h2>

    <% if leaderboards.elo_ranking.any? %>
      <ol>
        <% leaderboards.elo_ranking.each do |player_stat| %>
          <li>
            <strong><%= link_to player_stat.player.name, player_path(player_stat.player) %></strong>
            <span><%= player_stat.player.nickname %></span>
            <span><%= player_stat.elo || "-" %> Elo</span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="empty-state">Brak zawodnikow w rankingu Elo.</p>
    <% end %>
  </div>

  <div class="player-profile__body">
    <h2>Top strzelcy</h2>

    <% if leaderboards.top_scorers.any? %>
      <ol>
        <% leaderboards.top_scorers.each do |player_stat| %>
          <li>
            <strong><%= player_stat.player.name %></strong>
            <span><%= player_stat.goals %> goli</span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="empty-state">Brak strzelcow w tym sezonie.</p>
    <% end %>
  </div>

  <div class="player-profile__body">
    <h2>Top asysty</h2>

    <% if leaderboards.top_assistants.any? %>
      <ol>
        <% leaderboards.top_assistants.each do |player_stat| %>
          <li>
            <strong><%= player_stat.player.name %></strong>
            <span><%= player_stat.assists %> asyst</span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="empty-state">Brak asyst w tym sezonie.</p>
    <% end %>
  </div>

  <div class="player-profile__body">
    <h2>Top MVP</h2>

    <% if leaderboards.top_mvp.any? %>
      <ol>
        <% leaderboards.top_mvp.each do |player_stat| %>
          <li>
            <strong><%= player_stat.player.name %></strong>
            <span><%= player_stat.mvp_votes_count %> MVP</span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="empty-state">Brak glosow MVP w tym sezonie.</p>
    <% end %>
  </div>

  <div class="player-profile__body">
    <h2>Top DEF</h2>

    <% if leaderboards.top_def.any? %>
      <ol>
        <% leaderboards.top_def.each do |player_stat| %>
          <li>
            <strong><%= player_stat.player.name %></strong>
            <span><%= player_stat.def_votes_count %> DEF</span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="empty-state">Brak glosow DEF w tym sezonie.</p>
    <% end %>
  </div>

  <div class="player-profile__body">
    <h2>Ostatnie match days</h2>

    <% if recent_match_days.any? %>
      <ul>
        <% recent_match_days.each do |match_day| %>
          <li>
            <strong><%= match_day.played_on %></strong>
            <span><%= match_day.status %></span>
            <span><%= pluralize(match_day.players.size, "player") %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty-state">Brak match days w tym sezonie.</p>
    <% end %>
  </div>
</section>
