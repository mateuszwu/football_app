<% content_for :title, "#{season.name} - #{t("app.name")}" %>

<section class="section season-stats">
  <div class="section__header">
    <p class="eyebrow"><%= t("seasons.public_stats") %></p>
    <h1><%= season.name %></h1>
    <p>
      <%= season.starts_on %>
      -
      <%= season.ends_on || t("common.no_end_date") %>
    </p>
  </div>

  <%= form_with url: season_path(season), method: :get, local: true, class: "admin-form" do |form| %>
    <div class="form-field">
      <%= form.label :season_id, t("seasons.season") %>
      <%= form.select :season_id, options_from_collection_for_select(available_seasons, :id, :name, season.id) %>
    </div>
    <div class="form-actions">
      <%= form.submit t("common.filter"), class: "button button--secondary" %>
    </div>
  <% end %>

  <div class="summary-grid">
    <article class="summary-card">
      <span class="summary-card__label"><%= t("dashboard.labels.match_days") %></span>
      <strong><%= season.match_days_count %></strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label"><%= t("dashboard.labels.players") %></span>
      <strong><%= season.unique_players_count %></strong>
    </article>
    <article class="summary-card">
      <span class="summary-card__label"><%= t("dashboard.labels.appearances") %></span>
      <strong><%= season.player_appearances_count %></strong>
    </article>
  </div>

  <div class="player-profile__body">
    <h2><%= t("seasons.elo_ranking") %></h2>

    <% if leaderboards.elo_ranking.any? %>
      <ul class="leaderboard-list">
        <% leaderboards.ranked_elo.each do |ranked_stat| %>
          <% player_stat = ranked_stat.entry %>
          <li>
            <span class="leaderboard-rank"><%= ranked_stat.rank %></span>
            <strong><%= link_to player_stat.player.name, player_path(player_stat.player) %></strong>
            <span><%= player_stat.player.nickname %></span>
            <span><%= ranked_entry_display_value(ranked_stat) %> Elo</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty-state"><%= t("seasons.no_elo") %></p>
    <% end %>
  </div>

  <div class="player-profile__body">
    <h2><%= t("seasons.top_scorers") %></h2>

    <% if leaderboards.top_scorers.any? %>
      <ul class="leaderboard-list">
        <% leaderboards.ranked_top_scorers.each do |ranked_stat| %>
          <% player_stat = ranked_stat.entry %>
          <li>
            <span class="leaderboard-rank"><%= ranked_stat.rank %></span>
            <strong><%= player_stat.player.name %></strong>
            <span><%= t("dashboard.labels.goals_count", count: ranked_entry_display_value(ranked_stat).to_i) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty-state"><%= t("seasons.no_scorers") %></p>
    <% end %>
  </div>

  <div class="player-profile__body">
    <h2><%= t("seasons.top_assists") %></h2>

    <% if leaderboards.top_assistants.any? %>
      <ul class="leaderboard-list">
        <% leaderboards.ranked_top_assistants.each do |ranked_stat| %>
          <% player_stat = ranked_stat.entry %>
          <li>
            <span class="leaderboard-rank"><%= ranked_stat.rank %></span>
            <strong><%= player_stat.player.name %></strong>
            <span><%= t("dashboard.labels.assists_count", count: ranked_entry_display_value(ranked_stat).to_i) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty-state"><%= t("seasons.no_assists") %></p>
    <% end %>
  </div>

  <div class="player-profile__body">
    <h2><%= t("seasons.top_mvp") %></h2>

    <% if leaderboards.top_mvp.any? %>
      <ul class="leaderboard-list">
        <% leaderboards.ranked_top_mvp.each do |ranked_stat| %>
          <% player_stat = ranked_stat.entry %>
          <li>
            <span class="leaderboard-rank"><%= ranked_stat.rank %></span>
            <strong><%= player_stat.player.name %></strong>
            <span><%= ranked_entry_display_value(ranked_stat) %> MVP</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty-state"><%= t("seasons.no_mvp_votes") %></p>
    <% end %>
  </div>

  <div class="player-profile__body">
    <h2><%= t("seasons.top_def") %></h2>

    <% if leaderboards.top_def.any? %>
      <ul class="leaderboard-list">
        <% leaderboards.ranked_top_def.each do |ranked_stat| %>
          <% player_stat = ranked_stat.entry %>
          <li>
            <span class="leaderboard-rank"><%= ranked_stat.rank %></span>
            <strong><%= player_stat.player.name %></strong>
            <span><%= ranked_entry_display_value(ranked_stat) %> DEF</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty-state"><%= t("seasons.no_def_votes") %></p>
    <% end %>
  </div>

  <div class="player-profile__body">
    <h2><%= t("seasons.recent_match_days") %></h2>

    <% if recent_match_days.any? %>
      <ul>
        <% recent_match_days.each do |match_day| %>
          <li>
            <strong><%= match_day.played_on %></strong>
            <span><%= status_label(match_day.status) %></span>
            <span><%= t("dashboard.labels.players") %>: <%= match_day.players.size %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty-state"><%= t("seasons.no_match_days") %></p>
    <% end %>
  </div>
</section>
