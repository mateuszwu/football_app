<article class="match-day-match-card">
  <header class="match-day-match-card__top">
    <div>
      <strong><%= match_row.label %></strong>
      <span><%= match_day_time_range(match_row) %></span>
    </div>
    <span class="match-day-status match-day-status--small"><%= t("statuses.finished") %></span>
  </header>

  <div class="match-day-match-card__score">
    <div class="match-day-team-block">
      <div class="match-day-team-main">
        <% if match_row.home_captain.present? %>
          <%= player_identity_badge(match_row.home_captain, size: :sm, label: match_row.home_captain.name) %>
        <% else %>
          <span class="match-day-team-chip"></span>
        <% end %>
        <strong><%= match_row.home_team.name %></strong>
      </div>
      <% if match_row.home_captain.present? %>
        <small class="match-day-captain-line"><%= t("matches.captain_short") %> <%= match_row.home_captain.name %></small>
      <% end %>
    </div>

    <div class="match-day-score-block">
      <strong><%= match_row.home_score %> : <%= match_row.away_score %></strong>
      <span><%= match_row.result_label %></span>
    </div>

    <div class="match-day-team-block match-day-team-block--right">
      <div class="match-day-team-main">
        <strong><%= match_row.away_team.name %></strong>
        <% if match_row.away_captain.present? %>
          <%= player_identity_badge(match_row.away_captain, size: :sm, label: match_row.away_captain.name) %>
        <% else %>
          <span class="match-day-team-chip match-day-team-chip--away"></span>
        <% end %>
      </div>
      <% if match_row.away_captain.present? %>
        <small class="match-day-captain-line"><%= t("matches.captain_short") %> <%= match_row.away_captain.name %></small>
      <% end %>
    </div>
  </div>

  <div class="match-day-match-card__bottom">
    <%= link_to t("match_days.show.view_match"), match_path(match_row.match), class: "button button--secondary" %>
  </div>
</article>
