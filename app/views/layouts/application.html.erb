<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= javascript_importmap_tags %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "favicon.png", type: "image/png" %>
    <%= favicon_link_tag "favicon-32x32.png", type: "image/png", sizes: "32x32" %>
    <%= favicon_link_tag "favicon-16x16.png", type: "image/png", sizes: "16x16" %>
    <%= favicon_link_tag "android-chrome-192x192.png", type: "image/png", sizes: "192x192" %>
    <%= favicon_link_tag "android-chrome-512x512.png", type: "image/png", sizes: "512x512" %>
    <%= favicon_link_tag "apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <%
    body_class =
      if controller_path == "admin/sessions"
        "theme-dark public-layout"
      elsif controller_path.start_with?("admin/")
        "theme-light admin-layout"
      else
        "theme-dark public-layout"
      end
  %>

  <body class="<%= body_class %>">
    <header class="mobile-app-header" data-controller="mobile-nav">
      <div class="mobile-app-header__brand">
        <%= image_tag "branding/neon_green_football_emblem.png", class: "mobile-app-header__logo", alt: "Football App" %>
        <span class="mobile-app-header__title"><%= t("app.name") %></span>
      </div>

      <button type="button" class="mobile-app-header__menu-button" data-action="mobile-nav#open" aria-label="Otwórz menu">
        <%= safe_lucide_icon("menu", fallback: "circle", class_name: "mobile-app-header__menu-icon") %>
      </button>

      <div class="mobile-nav-overlay" data-mobile-nav-target="overlay" data-action="click->mobile-nav#close" hidden></div>

      <nav class="mobile-nav-drawer" data-mobile-nav-target="drawer" aria-label="Nawigacja mobilna" hidden>
        <div class="mobile-nav-drawer__header">
          <div class="mobile-nav-drawer__brand">
            <%= image_tag "branding/neon_green_football_emblem.png", class: "mobile-nav-drawer__logo", alt: "Football App" %>
            <span class="mobile-nav-drawer__title"><%= t("app.name") %></span>
          </div>

          <button type="button" class="mobile-nav-drawer__close" data-action="mobile-nav#close" aria-label="Zamknij menu">
            <%= safe_lucide_icon("x", fallback: "circle", class_name: "mobile-nav-drawer__close-icon") %>
          </button>
        </div>

        <div class="mobile-nav-drawer__links">
          <%= render "shared/navigation_links", variant: :mobile %>
        </div>
      </nav>
    </header>

    <header class="site-header">
      <nav class="site-nav" aria-label="<%= t("navigation.dashboard") %>">
        <%= link_to root_path, class: "site-nav__brand sidebar-brand" do %>
          <%= image_tag "branding/neon_green_football_emblem.png", alt: "Football App", class: "sidebar-brand__logo" %>
          <span class="sidebar-brand__text">
            <span class="sidebar-brand__title"><%= t("app.name") %></span>
            <span class="sidebar-brand__subtitle"><%= t("app.subtitle") %></span>
          </span>
        <% end %>

        <div class="site-nav__links">
          <%= render "shared/navigation_links", variant: :desktop %>
        </div>
      </nav>
    </header>

    <main class="app-main">
      <% if notice.present? %>
        <p class="flash flash--notice"><%= notice %></p>
      <% end %>

      <% if alert.present? %>
        <p class="flash flash--alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
