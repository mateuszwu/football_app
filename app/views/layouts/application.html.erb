<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= javascript_importmap_tags %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <%
    body_class =
      if controller_path.start_with?("admin/")
        "theme-light admin-layout"
      elsif controller_name == "matches" && action_name == "show"
        "theme-dark live-layout"
      else
        "theme-dark public-layout"
      end
  %>

  <body class="<%= body_class %>">
    <header class="site-header">
      <nav class="site-nav" aria-label="<%= t("navigation.dashboard") %>">
        <%= link_to t("app.name"), root_path, class: "site-nav__brand" %>

        <div class="site-nav__links">
          <%= link_to t("navigation.dashboard"), root_path(anchor: "dashboard"), class: ("site-nav__link site-nav__link--active" if controller_path == "home"), aria: ({ current: "page" } if controller_path == "home") %>
          <%= link_to leaderboards_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'leaderboards'}", aria: ({ current: "page" } if controller_path == "leaderboards") do %>
            <%= safe_lucide_icon("trophy", fallback: "chart-no-axes-combined", class_name: "site-nav__icon") %>
            <%= t("navigation.leaderboards") %>
          <% end %>
          <%= link_to t("navigation.relationships"), relationships_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'relationships'}", aria: ({ current: "page" } if controller_path == "relationships") %>
          <%= link_to t("navigation.players"), root_path(anchor: "dashboard"), class: "site-nav__link" %>
          <%= link_to t("navigation.join"), new_player_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'players' && action_name == 'new'}", aria: ({ current: "page" } if controller_path == "players" && action_name == "new") %>
          <% if admin_signed_in? %>
            <%= link_to t("navigation.match_days"), admin_match_days_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'admin/match_days'}", aria: ({ current: "page" } if controller_path == "admin/match_days") %>
            <%= link_to t("navigation.seasons"), admin_seasons_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'admin/seasons'}", aria: ({ current: "page" } if controller_path == "admin/seasons") %>
            <%= link_to t("navigation.admin"), admin_players_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'admin/players'}", aria: ({ current: "page" } if controller_path == "admin/players") %>
            <%= button_to t("navigation.logout"), admin_session_path, method: :delete, class: "site-nav__login site-nav__button" %>
          <% else %>
            <%= link_to t("navigation.login"), admin_login_path, class: "site-nav__login #{'site-nav__link--active' if controller_path == 'admin/sessions'}", aria: ({ current: "page" } if controller_path == "admin/sessions") %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="app-main">
      <% if notice.present? %>
        <p class="flash flash--notice"><%= notice %></p>
      <% end %>

      <% if alert.present? %>
        <p class="flash flash--alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
