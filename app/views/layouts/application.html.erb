<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= javascript_importmap_tags %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "favicon.png", type: "image/png" %>
    <%= favicon_link_tag "favicon-32x32.png", type: "image/png", sizes: "32x32" %>
    <%= favicon_link_tag "favicon-16x16.png", type: "image/png", sizes: "16x16" %>
    <%= favicon_link_tag "android-chrome-192x192.png", type: "image/png", sizes: "192x192" %>
    <%= favicon_link_tag "android-chrome-512x512.png", type: "image/png", sizes: "512x512" %>
    <%= favicon_link_tag "apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <%
    body_class =
      if controller_path == "admin/sessions"
        "theme-dark public-layout"
      elsif controller_path.start_with?("admin/")
        "theme-light admin-layout"
      else
        "theme-dark public-layout"
      end
  %>

  <body class="<%= body_class %>">
    <header class="site-header">
      <nav class="site-nav" aria-label="<%= t("navigation.dashboard") %>">
        <%= link_to root_path, class: "site-nav__brand sidebar-brand" do %>
          <%= image_tag "branding/neon_green_football_emblem.png", alt: "Football App", class: "sidebar-brand__logo" %>
          <span class="sidebar-brand__text">
            <span class="sidebar-brand__title"><%= t("app.name") %></span>
            <span class="sidebar-brand__subtitle"><%= t("app.subtitle") %></span>
          </span>
        <% end %>

        <div class="site-nav__links">
          <%= link_to root_path(anchor: "dashboard"), class: "site-nav__link #{'site-nav__link--active' if controller_path == 'home'}", aria: ({ current: "page" } if controller_path == "home") do %>
            <%= safe_lucide_icon("layout-dashboard", fallback: "home", class_name: "site-nav__icon") %>
            <%= t("navigation.dashboard") %>
          <% end %>
          <%= link_to leaderboards_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'leaderboards'}", aria: ({ current: "page" } if controller_path == "leaderboards") do %>
            <%= safe_lucide_icon("trophy", fallback: "chart-no-axes-combined", class_name: "site-nav__icon") %>
            <%= t("navigation.leaderboards") %>
          <% end %>
          <%= link_to relationships_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'relationships'}", aria: ({ current: "page" } if controller_path == "relationships") do %>
            <%= safe_lucide_icon("network", fallback: "share-2", class_name: "site-nav__icon") %>
            <%= t("navigation.relationships") %>
          <% end %>
          <%= link_to statistics_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'statistics'}", aria: ({ current: "page" } if controller_path == "statistics") do %>
            <%= safe_lucide_icon("activity", fallback: "chart-bar", class_name: "site-nav__icon") %>
            <%= t("navigation.statistics") %>
          <% end %>
          <%= link_to players_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'players' && action_name == 'index'}", aria: ({ current: "page" } if controller_path == "players" && action_name == "index") do %>
            <%= safe_lucide_icon("users", fallback: "user-round", class_name: "site-nav__icon") %>
            <%= t("navigation.players") %>
          <% end %>
          <% if public_join_enabled? %>
            <%= link_to new_player_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'players' && action_name == 'new'}", aria: ({ current: "page" } if controller_path == "players" && action_name == "new") do %>
              <%= safe_lucide_icon("user-plus", fallback: "circle-plus", class_name: "site-nav__icon") %>
              <%= t("navigation.join") %>
            <% end %>
          <% else %>
            <span class="site-nav__link site-nav__link--disabled" aria-disabled="true" title="<%= t("dashboard.cta.join_disabled") %>">
              <%= safe_lucide_icon("user-plus", fallback: "circle-plus", class_name: "site-nav__icon") %>
              <%= t("navigation.join") %>
            </span>
          <% end %>
          <% if admin_signed_in? %>
            <%= link_to t("navigation.match_days"), admin_match_days_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'admin/match_days'}", aria: ({ current: "page" } if controller_path == "admin/match_days") %>
            <%= link_to t("navigation.seasons"), admin_seasons_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'admin/seasons'}", aria: ({ current: "page" } if controller_path == "admin/seasons") %>
            <%= link_to t("navigation.admin"), admin_players_path, class: "site-nav__link #{'site-nav__link--active' if controller_path == 'admin/players'}", aria: ({ current: "page" } if controller_path == "admin/players") %>
            <%= button_to t("navigation.logout"), admin_session_path, method: :delete, class: "site-nav__login site-nav__button" %>
          <% else %>
            <%= link_to admin_login_path, class: "site-nav__login #{'site-nav__link--active' if controller_path == 'admin/sessions'}", aria: ({ current: "page" } if controller_path == "admin/sessions") do %>
              <%= safe_lucide_icon("log-in", fallback: "circle", class_name: "site-nav__icon") %>
              <%= t("navigation.login") %>
            <% end %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="app-main">
      <% if notice.present? %>
        <p class="flash flash--notice"><%= notice %></p>
      <% end %>

      <% if alert.present? %>
        <p class="flash flash--alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
